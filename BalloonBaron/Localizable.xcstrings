    "holding.withdrawHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Kasse von %1$@ liegen %2$@. Überwiesenes Geld geht an die Holding; Holdinggeld fließt nie in die Regionen zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %1$@ cash box holds %2$@. Money you move goes to the holding; holding money never goes back to the regions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caja de %1$@ tiene %2$@. El dinero que muevas pasa al holding; el dinero del holding nunca vuelve a las regiones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の金庫には%2$@ある。移した資金はホールディングスへ入り、ホールディングスの資金は地域へは戻らない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 금고에 %2$@이(가) 있습니다. 옮긴 돈은 지주회사로 가며, 지주회사 돈은 지역으로 돌아가지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kasasında %2$@ var. Aktardığın para holdinge geçer; holding parası ülkelere geri dönmez."
          }
        }
      }
    },
    "holding.withdrawHintFx": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Kasse von %1$@ liegen %2$@. Überwiesenes Geld wird durch 1,1 geteilt und kommt als Euro bei der Holding an; Holdinggeld fließt nie in die Regionen zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %1$@ cash box holds %2$@. Money you move is divided by 1.1 and reaches the holding as euros; holding money never goes back to the regions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caja de %1$@ tiene %2$@. El dinero que muevas se divide entre 1,1 y llega al holding en euros; el dinero del holding nunca vuelve a las regiones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の金庫には%2$@ある。移した資金は1.1で割られユーロとしてホールディングスへ入る。ホールディングスの資金は地域へは戻らない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 금고에 %2$@이(가) 있습니다. 옮긴 돈은 1.1로 나눠 유로로 지주회사에 들어가며, 지주회사 돈은 지역으로 돌아가지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kasasında %2$@ var. Aktardığın para 1,1'e bölünerek euro olarak holdinge geçer; holding parası ülkelere geri dönmez."
          }
        }
      }
    },
    "holding.withdrawTitle": {
