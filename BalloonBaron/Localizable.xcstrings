          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のパイロット学校を作る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 조종사 학교 세우기"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi pilot okulunu kur"
          }
        }
      }
    },
    "crew.schoolBuild.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Morgen bewirbt sich ein Absolvent. Absolventen arbeiten lebenslang 30 % günstiger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A graduate applies every morning. Graduates work for 30% less for life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mañana se presenta un graduado. Los graduados cobran un 30 % menos de por vida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝卒業生が一人応募してくる。卒業生は生涯30%安く働く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 아침 졸업생이 지원합니다. 졸업생은 평생 30% 저렴하게 일합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sabah bir mezun başvurur. Mezunlar ömür boyu %30 daha ucuza çalışır."
          }
        }
      }
    },
    "crew.schoolOpen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pilotenschule ist geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pilot school is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escuela de pilotos está abierta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パイロット学校は開校中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종사 학교가 운영 중입니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot okulun açık."
          }
        }
      }
    },
    "crew.schoolOpen.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Morgen ist ein Absolvent unter den Bewerbern. Absolventen arbeiten lebenslang 30 % günstiger, auch nach einer Beförderung. Verlierst du sie an die Konkurrenz, ist der Vorteil weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every morning one of the applicants is a graduate. Graduates work for 30% less for life, even after promotion. Lose them to a rival and the advantage is gone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mañana hay un graduado entre los candidatos. Los graduados cobran un 30 % menos de por vida, aunque asciendan. Si te los quita un rival, pierdes la ventaja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝、応募者の中に卒業生が一人いる。卒業生は昇進しても生涯30%安く働く。ライバルに取られればその利点は消える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 아침 지원자 중 졸업생이 한 명 있습니다. 졸업생은 승진해도 평생 30% 낮은 급여로 일합니다. 경쟁사에 뺏기면 이 이점은 사라집니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sabah başvuranlar arasında bir okul mezunu olur. Mezunlar ömür boyu %30 daha düşük maaşla çalışır, terfi etseler bile. Rakibe kaptırırsan bu avantaj gider."
          }
        }
      }
    },
