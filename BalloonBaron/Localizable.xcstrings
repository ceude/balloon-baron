    "event.rivalHotelDeal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat einen Vertrag mit %2$@. Das Hotel arbeitet 12 Tage mit niemand anderem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signed with %2$@. The hotel won't work with anyone else for 12 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ firmó con %2$@. El hotel no trabajará con nadie más durante 12 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が%2$@と契約。ホテルは12日間ほかの会社と組まない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 측이 %2$@와 제휴했습니다. 호텔은 12일간 다른 회사와 일하지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ ile anlaştı. Otel 12 gün boyunca başka şirketle çalışmayacak."
          }
        }
      }
    },
