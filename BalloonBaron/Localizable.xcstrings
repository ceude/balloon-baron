          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev tamamlandı: %1$@. Müşteri %2$@ ödül verdi."
          }
        }
      }
    },
    "event.missionFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
