    "event.perfectLanding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: perfekte Landung. Die Passagiere gaben %2$@ Trinkgeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: perfect landing. Passengers left %2$@ in tips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: aterrizaje perfecto. Los pasajeros dejaron %2$@ de propina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：完璧な着陸。乗客から%2$@のチップ。"
