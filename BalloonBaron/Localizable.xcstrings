          }
        }
      }
    },
    "home.alert.expired.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flieg heute selbst das Flaggschiff (kostenloser Erneuerungsflug) oder zahle %@ für die Erneuerung. Tippe für die Crew."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fly the flagship yourself today (free renewal flight) or pay %@ to renew. Tap for the crew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilota hoy tú el globo insignia (vuelo de renovación gratis) o paga %@ para renovarla. Toca para ver el equipo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日、旗艦を自分で飛ばす（無料の更新フライト）か、%@を払って更新しよう。タップでクルーへ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 기함을 직접 조종하거나(무료 갱신 비행) %@를 내고 갱신하세요. 탭하면 크루로 갑니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün amiral balonunu kendin uçur (ücretsiz yenileme uçuşu) ya da %@ ödeyip yenile. Ekip için dokun."
          }
        }
      }
    },
    "home.alert.expiring": {
      "extractionState": "manual",
      "localizations": {
