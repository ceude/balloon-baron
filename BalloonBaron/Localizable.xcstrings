    "review.far.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Landung warteten wir eine Stunde auf einem Feld auf den Bus. Die Aussicht war schön, aber…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We waited an hour in a field for the van after landing. The view was nice, but…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras aterrizar esperamos una hora en un campo a la furgoneta. La vista era bonita, pero…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着陸後、畑で1時間も車を待った。景色は良かったけど…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "착륙 후 들판에서 한 시간이나 차를 기다렸어요. 경치는 좋았지만…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnişten sonra bir tarlada bir saat araç bekledik. Manzara güzeldi ama…"
          }
        }
      }
    },
    "review.far.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich glaube, der Pilot wusste selbst nicht, wo wir gelandet waren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't think the pilot knew where we'd landed either."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creo que ni el piloto sabía dónde habíamos aterrizado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこに着陸したのか、パイロット自身もわかっていなかったと思う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디에 착륙했는지 조종사도 몰랐던 것 같아요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot nereye indiğimizi kendisi de bilmiyordu sanırım."
          }
        }
      }
    },
    "review.general.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Man kann nicht nach Kappadokien kommen und keinen Ballon fahren. Sehr professionelles Team."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't come to Cappadocia and skip the balloon. This team is very professional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes venir a Capadocia y no subir en globo. Este equipo es muy profesional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カッパドキアに来て気球に乗らないなんてありえない。とてもプロのチーム。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카파도키아에 와서 열기구를 안 탈 순 없죠. 정말 프로페셔널한 팀이에요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapadokya'ya gelip balona binmemek olmaz. Bu ekip çok profesyonel."
          }
        }
      }
    },
    "review.general.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aufstehen um 4 Uhr hat sich gelohnt. Der Himmel war voller Ballone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worth getting up at 4 a.m. The sky was full of hundreds of balloons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereció la pena madrugar a las 4. El cielo estaba lleno de cientos de globos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝4時起きの価値あり。空は何百もの気球でいっぱいだった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새벽 4시에 일어난 보람이 있었어요. 하늘이 수백 개의 열기구로 가득했어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah 4'te kalkmaya değdi. Gökyüzü yüzlerce balonla doluydu."
          }
        }
      }
    },
    "review.general.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sind mit {c} geflogen, alles war auf die Minute geplant."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We flew with {c}; everything was planned to the minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volamos con {c}; todo estaba planificado al minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{c}で飛んだ。すべてが分刻みで計画されていた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{c}와 함께 날았어요. 모든 게 분 단위로 계획되어 있었어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{c} ile uçtuk, her şey dakikası dakikasına planlıydı."
          }
        }
      }
    },
    "review.good.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aussicht war atemberaubend, die Landung etwas holprig, aber kein Problem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The view was stunning; the landing was a little bumpy, but no problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista fue impresionante; el aterrizaje, algo movido, pero sin problema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "景色は最高。着陸は少し揺れたけど問題なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경치가 최고였어요. 착륙이 좀 흔들렸지만 괜찮아요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manzara muhteşemdi, iniş biraz sarsıntılıydı ama sorun değil."
          }
        }
      }
    },
    "review.good.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Crew war sehr aufmerksam, die heiße Schokolade nach der Landung war wunderbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The crew was so attentive, and the hot chocolate after landing was wonderful."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El equipo fue muy atento y el chocolate caliente al aterrizar, maravilloso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタッフがとても親切で、着陸後のホットチョコが最高だった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직원들이 정말 세심했고 착륙 후 핫초코가 최고였어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekip çok ilgiliydi, inişteki sıcak çikolata ikramı harikaydı."
          }
        }
      }
    },
    "review.good.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotos sind unglaublich geworden, der Pilot kannte die besten Winkel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photos came out incredible; the pilot knew all the best angles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos salieron increíbles; el piloto conocía los mejores ángulos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が信じられないほど綺麗。パイロットは最高のアングルを知っていた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 끝내주게 나왔어요. 조종사가 최고의 각도를 알더라고요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar inanılmaz çıktı, pilot en güzel açıları biliyordu."
          }
        }
      }
    },
    "review.guide.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Guide in unserem Hotel hat diese Firma empfohlen. Gut, dass wir auf ihn gehört haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guide at our hotel recommended this company. Glad we listened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guía de nuestro hotel nos recomendó esta empresa. Menos mal que le hicimos caso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホテルのガイドがこの会社を勧めてくれた。聞いてよかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호텔 가이드가 이 회사를 추천했는데, 듣길 잘했어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otelimizdeki rehber bu şirketi önerdi, iyi ki dinlemişiz."
          }
        }
      }
    },
    "review.guide.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unser Guide ist selbst mit ihnen geflogen und hat sie uns empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our guide had flown with them himself and recommended them to us."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestro guía había volado con ellos y nos los recomendó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイド自身もここで飛んだことがあり、勧めてくれた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드가 직접 타 봤다며 이 회사를 추천해 줬어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehberimiz kendisi de uçmuş, bize bu firmayı tavsiye etti."
          }
        }
      }
    },
    "review.hard.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Korb kippte um, mein Knie tut immer noch weh. Ich überlege es mir zweimal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The basket tipped over and my knee still hurts. I'll think twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cesta volcó y aún me duele la rodilla. Me lo pensaré dos veces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バスケットが倒れて、まだ膝が痛い。次は考える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바스켓이 넘어져서 아직 무릎이 아파요. 다음엔 다시 생각해 볼래요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepet devrildi, dizim hâlâ ağrıyor. Bir daha düşünürüm."
          }
        }
      }
    },
    "review.hard.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Landung war ein echtes Rodeo. Überhaupt nicht lustig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The landing was a total rodeo. Not funny at all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aterrizaje fue un auténtico rodeo. Nada gracioso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着陸はまるでロデオ。全然笑えない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "착륙이 완전 로데오였어요. 하나도 안 웃겨요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İniş tam bir rodeo gibiydi. Hiç komik değil."
          }
        }
      }
    },
    "review.influencer.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir kamen wegen des Instagram-Videos von @gezginayse. Es war wirklich so schön, wie sie erzählt hat!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We came after seeing @gezginayse's video on Instagram. It really was as beautiful as she said!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinimos tras ver el vídeo de @gezginayse en Instagram. ¡Era tan bonito como contaba!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagramで@gezginayseの動画を見て来た。本当に言っていた通り素晴らしかった！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인스타그램에서 @gezginayse 영상을 보고 왔어요. 정말 말한 그대로 아름다웠어요!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instagram'da @gezginayse'nin videosunu görüp geldik. Gerçekten anlattığı kadar güzeldi!"
          }
        }
      }
    },
    "review.influencer.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir hatten es in einem YouTube-Vlog gesehen, die Crew war sehr freundlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'd seen it in a YouTube vlog; the crew was very friendly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo habíamos visto en un vlog de YouTube; el equipo fue muy amable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTubeのVlogで見た。スタッフがとてもフレンドリー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유튜브 브이로그에서 봤는데 직원들이 정말 친절했어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir YouTube vlogunda görmüştük, ekip çok güler yüzlüydü."
          }
        }
      }
    },
    "review.influencer.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben genau das Sonnenaufgangsfoto aus TikTok selbst geschossen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We got the same sunrise shot we saw on TikTok!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Sacamos la misma foto del amanecer que vimos en TikTok!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTokで見たあの日の出の写真、私たちも撮れた！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틱톡에서 본 그 일출 사진, 우리도 찍었어요!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok'ta gördüğümüz o gün doğumu karesini biz de çektik!"
          }
        }
      }
    },
    "review.meh.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht schlecht, aber die Crew war desinteressiert und der Ballon wirkte müde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not bad, but the crew didn't seem to care, and the balloon looked tired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No estuvo mal, pero al equipo no le importábamos y el globo parecía cansado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "悪くはないが、スタッフはそっけなく、気球もくたびれていた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나쁘진 않았지만 직원들이 무심했고 열기구도 낡아 보였어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fena değildi ama ekip pek ilgilenmedi, balon da yorgun görünüyordu."
          }
        }
      }
    },
    "review.meh.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach den Bewertungen waren wir skeptisch, leider zu Recht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We were a bit worried after reading the reviews; sadly, they were right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer las reseñas nos preocupó un poco; por desgracia, tenían razón."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レビューを読んで少し不安だったが、残念ながらその通りだった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리뷰를 보고 좀 걱정했는데, 아쉽게도 맞더라고요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorumları okuyup biraz çekinmiştik, maalesef haklı çıktılar."
          }
        }
      }
    },
    "review.meh.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aussicht war schön, die Firma mittelmäßig. Nächstes Mal probiere ich eine andere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The view was beautiful; the company, mediocre. I'll try another next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista era preciosa; la empresa, mediocre. La próxima vez probaré otra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "景色は美しかったが会社は平凡。次は別の会社にする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경치는 아름다웠지만 회사는 평범했어요. 다음엔 다른 곳을 가 볼래요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manzara güzeldi, şirket vasat. Bir dahakine başka firmayı denerim."
          }
        }
      }
    },
    "review.panorama.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unser Fotograf liebt das Bild aus 550 Metern. Ganz Kappadokien lag uns zu Füßen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our photographer loved the shot from 550 meters. All of Cappadocia was at our feet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A nuestro fotógrafo le encantó la foto desde 550 metros. Toda Capadocia a nuestros pies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラマンは550メートルからの一枚に大喜び。カッパドキア全体が足元に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진가가 550미터에서 찍은 사진에 반했어요. 카파도키아 전체가 발아래였어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafçımız 550 metreden çektiği kareye bayıldı. Bütün Kapadokya ayaklarımızın altındaydı."
          }
        }
      }
    },
    "review.panorama.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sind sehr hoch gestiegen, etwas kalt, aber die Aussicht war einzigartig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We went really high; a bit cold, but the view was unique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subimos muchísimo; hacía algo de frío, pero la vista era única."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "かなり高く上がった。少し寒かったけど景色は唯一無二。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아주 높이 올라가서 좀 추웠지만 경치는 유일무이했어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok yükseğe çıktık, biraz üşüdük ama manzara eşsizdi."
          }
        }
      }
    },
    "review.perfect.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pilot hat uns wie eine Feder mitten aufs Feld gesetzt. Kein Tropfen Champagner verschüttet!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pilot set us down in the middle of the field like a feather. Not a drop of champagne spilled!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El piloto nos posó en medio del campo como una pluma. ¡Ni una gota de champán derramada!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パイロットは畑の真ん中に羽のように降ろしてくれた。シャンパンが一滴もこぼれなかった！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종사가 깃털처럼 들판 한가운데 내려 줬어요. 샴페인 한 방울도 안 흘렸어요!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot bizi tarlanın tam ortasına kuş tüyü gibi indirdi. Şampanya bile dökülmedi!"
          }
        }
      }
    },
    "review.perfect.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonnenaufgang, Feenkamine und eine makellose Landung. Der Morgen meines Lebens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise, fairy chimneys and a flawless landing. The morning of my life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amanecer, chimeneas de hadas y un aterrizaje impecable. La mañana de mi vida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の出、妖精の煙突、そして完璧な着陸。人生最高の朝。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일출, 요정의 굴뚝, 완벽한 착륙. 인생 최고의 아침이었어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün doğumu, peribacaları ve kusursuz bir iniş. Hayatımın sabahıydı."
          }
        }
      }
    },
    "review.perfect.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kapitän liest den Wind förmlich. Ich würde sofort wieder fliegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The captain literally reads the wind. I'd fly again in a heartbeat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El capitán literalmente lee el viento. Volvería a volar sin dudarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプテンはまさに風を読んでいる。絶対にまた乗る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기장님이 바람을 읽어요. 무조건 또 탈 거예요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaptan rüzgârı okuyor resmen. Kesinlikle tekrar uçarım."
          }
        }
      }
    },
    "review.precision.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pilot setzte den Ballon direkt neben den Anhänger. Wir mussten keinen Schritt gehen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pilot set the balloon right next to the trailer. We didn't take a single step!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El piloto posó el globo justo al lado del remolque. ¡No dimos ni un paso!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パイロットは気球をトレーラーのすぐ横に降ろした。一歩も歩かなかった！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종사가 열기구를 트레일러 바로 옆에 내려놨어요. 한 걸음도 안 걸었어요!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot balonu tam karavanın yanına kondurdu, tek adım atmadık!"
          }
        }
      }
    },
    "review.precision.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So eine Landung bei diesem Wind… Meisterarbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A landing like that in this wind… Master's work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aterrizaje así con este viento… Trabajo de maestro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この風でこの着陸…まさに職人技。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 바람에 이런 착륙이라니… 장인의 솜씨예요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rüzgârlı havada bu iniş… Usta işi."
          }
        }
      }
    },
    "review.pricey.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schön war's, aber {p} ist etwas viel. Bei der Konkurrenz flogen andere billiger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was lovely, but {p} is a bit much. Others flew cheaper next door."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estuvo bonito, pero {p} es un poco caro. En la empresa de al lado volaron más barato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "良かったけど{p}は少し高い。隣の会社はもっと安かったらしい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋았지만 {p}는 좀 비싸요. 옆 회사는 더 싸게 탔대요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güzeldi ama {p} biraz fazla. Yan firmada daha ucuza uçmuşlar."
          }
        }
      }
    },
    "review.pricey.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erlebnis war gut, mein Geldbeutel hat allerdings geweint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The experience was good; my wallet, however, cried."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La experiencia fue buena; mi cartera, en cambio, lloró."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体験は良かった。財布は泣いたけど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경험은 좋았는데 지갑이 울었어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneyim iyiydi, fiyat ise cüzdanımı ağlattı."
          }
        }
      }
    },
    "review.proposal.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pilot hielt genau auf 300 Metern, und mein Schatz ging auf die Knie. Der Morgen meines Lebens!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pilot stopped right at 300 meters and my partner got down on one knee. The morning of my life!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El piloto se detuvo justo a 300 metros y mi pareja se arrodilló. ¡La mañana de mi vida!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パイロットがちょうど300メートルで止まり、恋人がひざまずいた。人生最高の朝！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종사가 딱 300미터에서 멈추고 연인이 무릎을 꿇었어요. 인생 최고의 아침!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot tam 300 metrede durdu, sevgilim diz çöktü. Hayatımın sabahıydı!"
          }
        }
      }
    },
    "review.proposal.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe am Himmel einen Antrag gemacht, das Team hat alles perfekt organisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I proposed in the sky, and the crew arranged everything perfectly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedí matrimonio en el cielo y el equipo lo organizó todo a la perfección."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空の上でプロポーズした。スタッフが全部完璧に準備してくれた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘에서 청혼했어요. 팀이 모든 걸 완벽하게 준비해 줬어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evlilik teklifimi gökyüzünde yaptım, ekip her şeyi kusursuz ayarladı."
          }
        }
      }
    },
    "review.red.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wind heulte, kein anderer Ballon war oben. Warum wir?!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wind was howling and no other balloon took off. Why did we?!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viento aullaba y ningún otro globo despegó. ¡¿Por qué nosotros sí?!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "風がうなり、ほかの気球は一機も飛んでいなかった。なぜ私たちは飛んだの？！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바람이 윙윙거리고 다른 열기구는 하나도 안 떴는데, 우린 왜 날았죠?!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rüzgâr uğulduyordu, başka hiçbir balon kalkmamıştı. Biz neden uçtuk?!"
          }
        }
      }
    },
    "review.red.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Firma, die Regeln ignoriert. Die Flagge war rot, und sie sind trotzdem gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A company that ignores the rules. The flag was red and they still took off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una empresa que ignora las normas. La bandera era roja y aun así despegaron."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールを守らない会社。旗は赤だったのに飛ばした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙을 무시하는 회사. 깃발이 빨간데도 띄웠어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurallara uymayan bir şirket. Bayrak kırmızıydı, yine de kaldırdılar."
          }
        }
      }
    },
    "review.rival.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigentlich wollten wir mit {r} fliegen, zum Glück haben wir umentschieden. {c} war großartig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We were going to fly with {r}; glad we changed our minds. {c} was amazing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Íbamos a volar con {r}; menos mal que cambiamos de idea. {c} fue increíble."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初は{r}で飛ぶつもりだったが、変えて正解。{c}は最高だった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 {r}로 가려다 마음을 바꿨는데 잘했어요. {c} 최고였어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce {r} ile uçacaktık, iyi ki fikrimizi değiştirmişiz. {c} harikaydı."
          }
        }
      }
    },
    "review.rival.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{r} war ausgebucht, also flogen wir mit {c}. Kein bisschen bereut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{r} was full, so we flew with {c}. No regrets at all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{r} estaba lleno, así que volamos con {c}. Ni un arrepentimiento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{r}は満席で、{c}で飛んだ。まったく後悔なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{r}가 꽉 차서 {c}로 탔는데, 전혀 후회 없어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{r} doluydu, {c} ile uçtuk. Hiç pişman değiliz."
          }
        }
      }
    },
    "review.skip.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Flug fiel wegen des Wetters aus, aber wir bekamen sofort unser Geld zurück. Sicherheit geht vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flight was called off because of the weather, but they refunded us right away. Safety first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vuelo se canceló por el tiempo, pero nos devolvieron el dinero enseguida. La seguridad es lo primero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天候で中止になったが、すぐに返金してくれた。安全第一。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨 때문에 취소됐지만 바로 환불해 줬어요. 안전이 우선이죠."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava yüzünden uçuş iptal oldu ama paramızı hemen iade ettiler. Güvenlik önce gelir."
          }
        }
      }
    },
    "review.skip.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wegen des Windes verschoben, für den nächsten Tag haben sie sofort Plätze gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Postponed because of the wind; they found us a spot the next day right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplazó por el viento y nos encontraron sitio al día siguiente enseguida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "風で延期になったが、翌日の枠をすぐ用意してくれた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바람 때문에 미뤄졌지만 다음 날 자리를 바로 잡아 줬어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rüzgâr yüzünden ertelendi, ertesi güne hemen yer buldular."
          }
        }
      }
    },
    "review.valley.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir glitten durchs Taubental, als könnten wir die Felsen berühren!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We glided through Pigeon Valley; it felt like we could touch the rocks!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeamos por el Valle de las Palomas; ¡parecía que podíamos tocar las rocas!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鳩の谷を滑るように飛んだ。岩に触れそうだった！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비둘기 계곡 사이로 미끄러지듯 날았어요. 바위에 손이 닿을 것 같았어요!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvercinlik Vadisi'nin içinden süzüldük, kayalara dokunacak gibiydik!"
          }
        }
      }
    },
    "review.valley.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tiefflug durchs Tal war unglaublich, wir flogen Seite an Seite mit Tauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The low flight through the valley was incredible; we flew side by side with pigeons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vuelo bajo por el valle fue increíble; volamos junto a las palomas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "谷の低空飛行は最高。鳩と並んで飛んだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계곡 저공비행은 대단했어요. 비둘기와 나란히 날았어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vadide alçak uçuş inanılmazdı, güvercinlerle yan yana uçtuk."
          }
        }
      }
    },
    "review.xl.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der riesige {c}-Ballon war auf allen Fotos, und wir waren drin!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That giant {c} balloon was in everyone's photos, and we were inside it!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Ese globo gigante de {c} salía en las fotos de todos, y nosotros íbamos dentro!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空に浮かぶ巨大な{c}の気球はみんなの写真に写っていた。私たちはその中にいた！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘의 거대한 {c} 열기구가 모두의 사진에 있었고, 우린 그 안에 있었어요!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gökyüzündeki o dev {c} balonu herkesin fotoğrafındaydı, biz de içindeydik!"
          }
        }
      }
    },
    "review.xl.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Riesenballon für 32 Personen war unglaublich. Der Korb war wie ein Balkon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 32-person giant balloon was unbelievable. The basket felt like a balcony."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El globo gigante de 32 plazas fue increíble. La cesta parecía un balcón."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "32人乗りの巨大気球は信じられない。バスケットはまるでバルコニー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "32인승 거대 열기구는 믿기지 않았어요. 바스켓이 발코니 같았어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "32 kişilik dev balon inanılmazdı. Sepet bir balkon gibiydi."
          }
        }
      }
    },
    "review.xl.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben den Kappadokien-Stern von Weitem gesehen und gebucht. Keine Reue."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We saw the Cappadocia Star from afar and booked. No regrets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vimos la Estrella de Capadocia de lejos y reservamos. Sin arrepentimientos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠くからカッパドキアの星を見て予約した。後悔なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀리서 카파도키아의 별을 보고 예약했어요. 후회 없어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapadokya Yıldızı'nı uzaktan görüp rezervasyon yaptık, pişman değiliz."
