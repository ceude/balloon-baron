    "paper.festival.sub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Tage lang wird das Tal voller Touristen sein, und Sonderwünsche zahlen gut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For three days the valley will be full of tourists, and special requests pay well."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante tres días el valle se llenará de turistas, y los encargos especiales pagan bien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日間、谷は観光客でいっぱい。特別リクエストの報酬もたっぷり。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3일 동안 계곡은 관광객으로 가득하고 특별 요청 보상도 큽니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç gün boyunca vadi turist dolacak, özel istekler bol ödüllü."
          }
        }
      }
    },
