    "issue.war.a.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einnahmen sinken dauerhaft um 10 %, aber du behältst deinen Markt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income drops 10% for good, but you keep your market."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ingresos bajan un 10 % para siempre, pero conservas tu mercado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収入は恒久的に10%下がるが、市場は守れる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수입이 영구적으로 10% 줄지만 시장을 지킵니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kazanç kalıcı olarak %10 düşer ama pazarını korursun."
          }
        }
      }
    },
    "issue.war.b": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Beliebtheit vertrauen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust your popularity"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confiar en tu popularidad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人気を信じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인기를 믿기"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popülerliğine güven"
          }
        }
      }
    },
    "issue.war.b.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fifty-fifty: Nichts passiert, oder die Einnahmen sinken 10 Tage um 25 %."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fifty-fifty: nothing happens, or income drops 25% for 10 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitad y mitad: no pasa nada o los ingresos bajan un 25 % durante 10 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "五分五分：何も起きないか、10日間収入が25%下がる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반반: 아무 일 없거나 10일간 수입 25% 감소."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarı yarıya: ya bir şey olmaz ya da 10 gün kazanç %25 düşer."
          }
        }
      }
    },
    "issue.war.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Konkurrent hat die Preise gesenkt, deine Ballone fliegen halb leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rival cut its prices and your balloons are flying half empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rival bajó sus precios y tus globos vuelan medio vacíos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライバルが値下げし、君の気球は半分空で飛んでいる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경쟁사가 가격을 내려 열기구가 반쯤 빈 채로 날고 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir rakip biletleri ucuzlattı, balonların yarı boş uçuyor."
          }
        }
      }
    },
    "issue.war.hez": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deine Beliebtheit hoch ist, kann Abwarten klappen. Wenn nicht, schütze deinen Markt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your popularity is high, waiting can work. If you're not sure, protect your market."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu popularidad es alta, esperar puede funcionar. Si no estás seguro, protege tu mercado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人気が高ければ待つのも手だ。自信がなければ市場を守れ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인기가 높다면 기다리는 것도 방법이지. 확신이 없으면 시장을 지키게."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popülerliğin yüksekse beklemek işe yarayabilir. Ama emin değilsen pazarını koru."
          }
        }
      }
    },
