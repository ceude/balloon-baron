    "home.alert.fiesta.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast doppelt so viele Touristen, der Himmel ist voller Ballone. Schick alle deine Ballone hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearly twice the tourists, and the sky is full of hundreds of balloons. Get all your balloons up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi el doble de turistas y el cielo lleno de cientos de globos. Sube todos tus globos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観光客はほぼ2倍、空は何百もの気球でいっぱい。全部の気球を上げよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관광객이 거의 두 배, 하늘은 수백 개의 열기구로 가득합니다. 모든 열기구를 띄우세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Turist neredeyse iki katı, gökyüzü yüzlerce balonla dolu. Bütün balonlarını kaldır."
          }
        }
      }
    },
