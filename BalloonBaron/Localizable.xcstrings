    "marketPage.hotelOwnBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Hotel: keine Gebühr. Zimmereinnahmen: ~%1$@/Tag. Gäste: ~%2$@. Beliebtheit: +%3$@/Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hotel: no fee. Room income: ~%1$@/day. Guests: ~%2$@. Popularity: +%3$@/day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu hotel: sin cuota. Ingresos por habitaciones: ~%1$@/día. Huéspedes: ~%2$@. Popularidad: +%3$@/día."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのホテル：手数料なし。客室収入：約%1$@/日。宿泊客：約%2$@。人気：+%3$@/日。"
          }
