    "review.hard.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Korb kippte um, mein Knie tut immer noch weh. Ich überlege es mir zweimal."
