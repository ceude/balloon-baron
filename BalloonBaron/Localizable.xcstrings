    "home.alert.expiring.days": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbleibende Tage: %1$@. Wenn du bis dahin nicht selbst fliegst, verfällt deine Lizenz: Deine anderen Ballone bleiben am Boden, und du musst selbst fliegen oder %2$@ zahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days left: %1$@. If you don't fly yourself by then, your license lapses: your other balloons stay grounded, and you'll have to fly yourself or pay %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días restantes: %1$@. Si para entonces no vuelas tú, tu licencia caduca: tus otros globos se quedan en tierra y tendrás que volar tú o pagar %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り日数：%1$@。それまでに自分で飛ばないと免許が切れる。ほかの気球は飛べなくなり、自分で飛ぶか%2$@を払うしかない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 일수: %1$@. 그때까지 직접 비행하지 않으면 면허가 만료됩니다. 다른 열기구는 지상에 묶이고, 직접 비행하거나 %2$@를 내야 합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan gün: %1$@. O zamana kadar kendin uçmazsan lisansın düşer: diğer balonların yerde kalır, ya kendin uçarsın ya da %2$@ ödersin."
          }
        }
      }
    },
    "home.alert.expiring.today": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du heute nicht selbst fliegst, verfällt deine Lizenz: Deine anderen Ballone bleiben am Boden, und du musst selbst fliegen oder %@ zahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't fly yourself today, your license lapses: your other balloons stay grounded, and you'll have to fly yourself or pay %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hoy no vuelas tú, tu licencia caduca: tus otros globos se quedan en tierra y tendrás que volar tú o pagar %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日自分で飛ばないと免許が切れる。ほかの気球は飛べなくなり、自分で飛ぶか%@を払うしかない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 직접 비행하지 않으면 면허가 만료됩니다. 다른 열기구는 지상에 묶이고, 직접 비행하거나 %@를 내야 합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün kendin uçmazsan lisansın düşer: diğer balonların yerde kalır, ya kendin uçarsın ya da %@ ödersin."
          }
        }
      }
    },
    "home.alert.festival": {
