    "rescue.fire.sub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sparst %@ Lohn pro Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You save %@ a day in wages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorras %@ al día en sueldos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日%@の人件費が浮く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 인건비 %@를 아낍니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde %@ maaştan kurtulursun."
          }
        }
      }
    },
    "rescue.hez": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Kasse ist im Minus, Lehrling. Keine Panik, aber wir müssen heute handeln. Unter %@ pfändet die Bank einen Ballon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cash went below zero, kid. No panic, but we must do something today. Below %@ the bank takes a balloon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu caja ha caído por debajo de cero, aprendiz. Sin pánico, pero hoy hay que hacer algo. Por debajo de %@ el banco embarga un globo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資金がマイナスになったぞ、弟子よ。慌てるな、だが今日のうちに手を打たねば。%@を下回ると銀行が気球を差し押さえる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고가 마이너스가 됐네, 제자여. 당황하지 말게, 하지만 오늘 뭔가 해야 하네. %@ 아래로 떨어지면 은행이 열기구를 압류한다네."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasan eksiye düştü evlat. Panik yok, ama bugün bir şeyler yapmalıyız. %@ altına inersen banka balonuna el koyar."
          }
        }
      }
    },
    "rescue.loan": {
      "extractionState": "manual",
      "localizations": {
