    "event.pilotPromoted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist jetzt Pilot der Stufe %2$@! Weniger Unfallrisiko, Gehalt jetzt %3$@/Tag."
          }
        },
        "en": {
          "stringUnit": {
