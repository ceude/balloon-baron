    "flag.note.green": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gutes Flugwetter, leichter Wind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to fly, light winds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen día para volar, viento suave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飛行に適した日。風は穏やか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비행하기 좋은 날, 바람이 약합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçuşa uygun, rüzgâr hafif."
          }
        }
      }
    },
    "flag.note.red": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fliegen verboten. Du könntest erwischt werden, und die Versicherung zahlt nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flying is banned. You might get caught, and insurance pays nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volar está prohibido. Te pueden pillar y el seguro no paga nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飛行禁止。見つかる可能性があり、保険は一切払われない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비행 금지. 적발될 수 있고 보험은 아무것도 보상하지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçuş yasak. Kalkarsan yakalanabilirsin ve sigorta hiçbir şeyi ödemez."
          }
        }
      }
    },
    "flag.note.yellow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst fliegen, aber Unfallrisiko und Versicherungsprämien sind hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may fly, but accident risk and insurance premiums are high."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volar, pero el riesgo de accidente y las primas del seguro son altos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飛べるが、事故リスクと保険料が高い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비행은 가능하지만 사고 위험과 보험료가 높습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçabilirsin ama kaza riski ve sigorta primleri yüksek."
          }
        }
      }
    },
