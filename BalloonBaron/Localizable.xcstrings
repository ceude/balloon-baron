    "crew.candidates.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehälter werden jeden Tag gezahlt, auch wenn ein Ballon nicht fliegt. Piloten sammeln beim Fliegen Erfahrung: Ein Anfänger wird nach 40 Flügen erfahren, ein erfahrener Pilot nach 100 zum Kapitän, und das Gehalt steigt. Die Bewerber wechseln jeden Morgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wages are paid every day, even when a balloon doesn't fly. Pilots gain experience as they fly: a rookie becomes experienced after 40 flights, an experienced pilot becomes senior after 100, and their wage rises. Applicants change every morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sueldos se pagan cada día, aunque el globo no vuele. Los pilotos ganan experiencia al volar: un novato pasa a experimentado tras 40 vuelos, un experimentado a veterano tras 100, y su sueldo sube. Los candidatos cambian cada mañana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給料は気球が飛ばない日も毎日払う。パイロットは飛ぶほど経験を積む。新人は40回で中堅、中堅は100回でベテランになり、給料も上がる。応募者は毎朝入れ替わる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급여는 열기구가 뜨지 않아도 매일 나갑니다. 조종사는 비행할수록 경험을 쌓습니다. 신입은 40회 비행 후 숙련, 숙련은 100회 후 베테랑이 되고 급여도 오릅니다. 지원자는 매일 아침 바뀝니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaşlar balon uçmasa da her gün ödenir. Pilotlar uçtukça tecrübe kazanır: çaylak 40 uçuşta deneyimli, deneyimli 100 uçuşta kıdemli olur ve maaşı da yükselir. Başvuranlar her sabah değişir."
          }
        }
      }
    },
