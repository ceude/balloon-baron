    "event.doc.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sender dreht eine Doku über %@. Wenn du den Kameras 4 Plätze im Flaggschiff gibst, zeigen sie dich darin. Diese 4 Plätze kannst du heute nicht verkaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A broadcaster is filming a documentary about %@. If you give their cameras 4 seats in the flagship, they will show you in it. You can't sell those 4 seats today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cadena rueda un documental sobre %@. Si das 4 asientos del globo insignia a sus cámaras, saldrás en él. Hoy no podrás vender esos 4 asientos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "放送局が%@のドキュメンタリーを撮影中。旗艦の4席をカメラに譲れば番組に出してくれる。今日その4席は売れない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 방송사가 %@ 다큐멘터리를 찍고 있습니다. 기함의 4석을 카메라에 내주면 다큐멘터리에 소개해 줍니다. 오늘 그 4석은 팔 수 없습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yayın kuruluşu %@ belgeseli çekiyor. Amiral balonunda 4 koltuğu kameralara ayırırsan seni belgeselde gösterecekler. Bugün o 4 koltuğa bilet satamazsın."
          }
        }
      }
    },
