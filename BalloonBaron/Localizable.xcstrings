    "flight.land.crash": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Du hast einen Feenkamin gerammt!** Der Ballon ist schwer beschädigt, die Passagiere sind verletzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**You hit a fairy chimney!** The balloon is badly damaged and passengers are injured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**¡Chocaste con una chimenea de hadas!** El globo está muy dañado y los pasajeros, heridos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**妖精の煙突に激突**！気球は大破し、乗客がけがをした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**요정의 굴뚝에 부딪혔습니다!** 열기구가 크게 부서지고 승객들이 다쳤습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Peribacasına çarptın!** Balon ağır hasarlı, yolcular yaralı."
          }
        }
      }
    },
    "flight.land.crash.abq": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Du bist in eine Pappel gekracht!** Der Ballon ist schwer beschädigt, die Passagiere sind verletzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**You hit a cottonwood!** The balloon is badly damaged and passengers are injured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**¡Chocaste con un álamo!** El globo está muy dañado y los pasajeros, heridos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**ハコヤナギに激突**！気球は大破し、乗客がけがをした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**미루나무에 부딪혔습니다!** 열기구가 크게 부서지고 승객들이 다쳤습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kavak ağacına çarptın!** Balon ağır hasarlı, yolcular yaralı."
          }
        }
      }
    },
    "flight.land.far": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Du bist %@ m vom Ziel entfernt gelandet.** Die Passagiere mussten eine Stunde warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**You landed %@ m from the target.** Passengers had to wait an hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Aterrizaste a %@ m del objetivo.** Los pasajeros tuvieron que esperar una hora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**目標から%@ m離れて着陸**。乗客は1時間待たされた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**목표에서 %@ m 떨어진 곳에 착륙했습니다.** 승객들은 한 시간을 기다려야 했습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hedeften %@ m uzağa indin.** Yolcular bir saat beklemek zorunda kaldı."
          }
        }
      }
    },
    "flight.land.good": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gute Landung.** Die Bodencrew hat dich sofort gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Good landing.** The ground crew found you right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Buen aterrizaje.** El equipo de tierra te encontró enseguida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**良い着陸**。地上クルーがすぐに見つけてくれた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**좋은 착륙.** 지상 요원이 바로 찾아왔습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**İyi iniş.** Yer ekibi seni hemen buldu."
          }
        }
      }
    },
    "flight.land.hard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Harte Landung!** Der Korb ist umgekippt, die Passagiere sind leicht verletzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hard landing!** The basket tipped over and passengers have minor injuries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**¡Aterrizaje brusco!** La cesta volcó y los pasajeros tienen heridas leves."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**ハードランディング**！バスケットが倒れ、乗客が軽いけがをした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**거친 착륙!** 바스켓이 넘어져 승객들이 가벼운 부상을 입었습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sert iniş!** Sepet devrildi, yolcularda hafif yaralanmalar var."
          }
        }
      }
    },
    "flight.land.perfect": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Perfekte Landung!** Genau in der Mitte des Landefelds."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Perfect landing!** Right in the middle of the landing field."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**¡Aterrizaje perfecto!** Justo en el centro del campo de aterrizaje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**完璧な着陸**！着陸場のど真ん中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**완벽한 착륙!** 착륙장 한가운데입니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kusursuz iniş!** İniş alanının tam ortası."
          }
        }
      }
    },
