    "event.rivalStoleHotel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ hat ein besseres Angebot von %1$@ angenommen und deinen Vertrag beendet!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ took a better offer from %1$@ and ended its deal with you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡%2$@ aceptó una oferta mejor de %1$@ y terminó su acuerdo contigo!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@が%1$@のより良い条件を受け入れ、あなたとの契約を打ち切った！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 측이 %1$@의 더 좋은 제안을 받아들여 나와의 제휴를 끝냈습니다!"
          }
        },
        "tr": {
