    "bazaar.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schmücke deine Stadt und kauf besondere Muster und Formen für deine Ballone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decorate your town; buy special patterns and shapes for your balloons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decora tu pueblo y compra diseños y formas especiales para tus globos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "町を飾り、気球に特別な柄や形を買おう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마을을 꾸미고 열기구에 특별한 무늬와 모양을 사세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasabanı süsle, balonlarına özel desen ve şekil al."
          }
        }
      }
    },
    "bazaar.localPrices": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Preise erscheinen im App Store in deiner Landeswährung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices show in your country's currency on the App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios aparecen en la App Store en la moneda de tu país."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格はApp Storeでお住まいの国の通貨で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격은 App Store에서 해당 국가의 통화로 표시됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatlar App Store'da ülkene göre yerel para biriminde görünür."
