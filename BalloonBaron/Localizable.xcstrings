    "repChart.bonusBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hohe Beliebtheit bringt zusätzliche Passagiere, egal was die Konkurrenz tut: bis zu %1$@ deiner Plätze. Zusätzliche Passagiere heute zu diesem Preis: etwa %2$@. Unter %3$@ entfällt der Effekt, bei %4$@ erreicht er %5$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High popularity brings extra passengers whatever your rivals do, up to %1$@ of your seats. Extra passengers today at this price: about %2$@. Below %3$@ the effect is gone; at %4$@ it reaches %5$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una popularidad alta trae pasajeros extra hagan lo que hagan tus rivales: hasta el %1$@ de tus plazas. Pasajeros extra hoy a este precio: unos %2$@. Por debajo de %3$@ el efecto desaparece; con %4$@ llega al %5$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人気が高いと、ライバルに関係なく乗客が増える（座席の最大%1$@）。この価格での今日の追加乗客：約%2$@。%3$@未満では効果なし、%4$@で%5$@に達する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인기가 높으면 경쟁사와 상관없이 승객이 더 옵니다(좌석의 최대 %1$@). 이 가격에서 오늘 추가 승객: 약 %2$@. %3$@ 미만이면 효과가 없고 %4$@에서 %5$@에 이릅니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek popülerlik, rakiplerden bağımsız ekstra yolcu getirir: koltuklarının en fazla %1$@ kadarı. Bugün bu fiyatla ekstra yolcu: yaklaşık %2$@. %3$@ altında bu etki sıfırlanır, %4$@ seviyesinde %5$@ olur."
          }
        }
      }
    },
