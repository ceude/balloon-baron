    "map.here.abq": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wüste, die Sandia-Berge und die berühmten Box-Winde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desert, the Sandia mountains and the famous box winds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desierto, las montañas Sandia y los famosos vientos de caja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "砂漠、サンディア山脈、そして名高いボックス風。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사막, 샌디아 산맥, 그리고 유명한 박스 바람."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöl, Sandia dağları ve meşhur kutu rüzgârları."
          }
        }
      }
    },
    "map.here.cap": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feenkamine und Sonnenaufgang. Wo alles begann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fairy chimneys and sunrise. Where it all began."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chimeneas de hadas y amanecer. Donde todo empezó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "妖精の煙突と日の出。すべてが始まった場所。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요정의 굴뚝과 일출. 모든 것이 시작된 곳."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
