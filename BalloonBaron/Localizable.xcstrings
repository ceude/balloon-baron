    "review.proposal.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pilot hielt genau auf 300 Metern, und mein Schatz ging auf die Knie. Der Morgen meines Lebens!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pilot stopped right at 300 meters and my partner got down on one knee. The morning of my life!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El piloto se detuvo justo a 300 metros y mi pareja se arrodilló. ¡La mañana de mi vida!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パイロットがちょうど300メートルで止まり、恋人がひざまずいた。人生最高の朝！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종사가 딱 300미터에서 멈추고 연인이 무릎을 꿇었어요. 인생 최고의 아침!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot tam 300 metrede durdu, sevgilim diz çöktü. Hayatımın sabahıydı!"
          }
        }
      }
    },
    "review.proposal.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe am Himmel einen Antrag gemacht, das Team hat alles perfekt organisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I proposed in the sky, and the crew arranged everything perfectly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedí matrimonio en el cielo y el equipo lo organizó todo a la perfección."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空の上でプロポーズした。スタッフが全部完璧に準備してくれた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘에서 청혼했어요. 팀이 모든 걸 완벽하게 준비해 줬어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
