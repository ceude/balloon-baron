    "event.goodLanding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: saubere Landung, zufriedene Passagiere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: smooth landing, happy passengers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: buen aterrizaje, pasajeros contentos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：スムーズな着陸。乗客は満足。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 부드러운 착륙, 승객 만족."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: düzgün iniş, yolcular memnun."
          }
        }
      }
