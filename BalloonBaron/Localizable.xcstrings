    "deal.sale.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auslastung ist gesunken oder das Geld wurde knapp. Du kannst die Firma und ihre Ballons (%1$@) für %2$@ übernehmen. Der Konkurrent verlässt den Markt und seine Passagiere gehören dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its bookings fell or its money ran low. You can take over the company and its balloons (%1$@) for %2$@. The rival leaves the market and its passengers are yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajó su ocupación o se quedó sin dinero. Puedes quedarte con la empresa y sus globos (%1$@) por %2$@. El rival sale del mercado y sus pasajeros son tuyos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "搭乗率が落ちたか、資金が尽きかけています。会社と気球（%1$@機）を%2$@で買収できます。ライバルは市場から去り、乗客はあなたのものに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탑승률이 떨어졌거나 돈이 바닥났습니다. 회사와 열기구(%1$@대)를 %2$@에 인수할 수 있습니다. 경쟁사는 시장에서 물러나고 승객은 당신 차지입니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doluluğu düştü ya da parası azaldı. Şirketi ve %1$@ balonunu devralabilirsin, fiyatı %2$@. Rakibin pazardan çekilir, yolcuları sana kalır."
          }
        }
      }
    },
    "deal.sale.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ steht zum Verkauf!"
          }
        },
        "en": {
