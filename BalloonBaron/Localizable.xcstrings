    "merge.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und %2$@ ertrugen deinen Marktanteil von %3$@ nicht und haben sich zusammengetan. Die neue Firma: %4$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ and %2$@ couldn't stand you holding %3$@ of the market, so they joined forces. The new company: %4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ y %2$@ no soportaron que tengas el %3$@ del mercado y unieron fuerzas. La nueva empresa: %4$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@と%2$@は、君が市場の%3$@を握ることに耐えられず手を組んだ。新会社：%4$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@와(과) %2$@은(는) 당신의 시장 점유율 %3$@을(를) 견디지 못해 힘을 합쳤습니다. 새 회사: %4$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ile %2$@, pazardaki %3$@ payına dayanamadı ve güçlerini birleştirdi. Yeni şirket: %4$@."
          }
        }
      }
    },
