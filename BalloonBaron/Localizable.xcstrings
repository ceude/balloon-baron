    "poach.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %1$@ (%2$@) %3$@ pro Tag angeboten. Im Moment verdient er %4$@. Damit er bleibt, musst du das Gehalt angleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They offered %1$@ (%2$@) %3$@ a day. Right now they earn %4$@. To keep them, you have to match the wage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ofrecieron a %1$@ (%2$@) %3$@ al día. Ahora cobra %4$@. Para que se quede, tienes que igualar el sueldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）に日給%3$@を提示しました。今の日給は%4$@。引き留めるには同額に上げる必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(%2$@)에게 하루 %3$@를 제안했습니다. 지금은 %4$@를 받습니다. 붙잡으려면 급여를 맞춰야 합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) için günlük %3$@ teklif ettiler. Şu an %4$@ alıyor. Kalması için maaşını eşitlemen gerekiyor."
          }
        }
      }
    },
    "poach.letGo": {
