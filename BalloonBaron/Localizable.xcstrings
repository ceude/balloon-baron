    "marketPage.offerBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ steht zum Verkauf. Die Auslastung ist gesunken oder das Geld wird knapp. Du kannst die Firma mit allen Ballonen für %2$@ übernehmen. Ballone: %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is for sale. Its load dropped or it ran low on money. You can take over the company and all its balloons for %2$@. Balloons: %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está en venta. Bajó su ocupación o se quedó sin dinero. Puedes quedarte con la empresa y todos sus globos por %2$@. Globos: %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が売りに出ている。搭乗率が落ちたか資金が尽きかけている。会社と全気球を%2$@で買収できる。気球：%3$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 매물로 나왔습니다. 탑승률이 떨어졌거나 자금이 바닥났습니다. %2$@에 회사와 모든 열기구를 인수할 수 있습니다. 열기구: %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ satılık. Doluluğu düştü ya da parası azaldı. Şirketi ve bütün balonlarını %2$@ karşılığında devralabilirsin. Balon: %3$@."
          }
        }
      }
    },
