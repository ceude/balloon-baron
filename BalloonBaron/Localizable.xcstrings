    "event.vip.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Geschäftsmann aus dem %1$@ möchte %2$@ für seine Familie chartern. Sie zahlen %3$@ im Voraus; der Ballon nimmt heute keine anderen Fahrgäste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A businessman staying at %1$@ wants to charter %2$@ for his family. They pay %3$@ up front; the balloon takes no other passengers today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un empresario alojado en %1$@ quiere alquilar %2$@ para su familia. Pagan %3$@ por adelantado; el globo no lleva más pasajeros hoy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に泊まる実業家が家族のために%2$@を貸し切りたいという。前金で%3$@払う。今日この気球は他の客を乗せない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 묵는 사업가가 가족과 함께 %2$@를 통째로 빌리고 싶어 합니다. 선불로 %3$@를 내며, 이 열기구는 오늘 다른 승객을 받지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ otelinden bir iş insanı ailesiyle %2$@ balonunu bütünüyle kiralamak istiyor. Peşin %3$@ öderler, balon bugün başka yolcu almaz."
          }
        }
      }
    },
