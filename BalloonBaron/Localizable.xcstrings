    "crew.rule": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Piloten werden jeden Morgen eingeteilt: Die erfahrensten bekommen die größten flugfähigen Ballone, Anfänger die kleinen. Ballone in Reparatur oder mit verschlissener Hülle kommen zuletzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilots are assigned every morning: the most senior get the biggest balloons that can fly, rookies the small ones. Balloons in repair or with a worn envelope come last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pilotos se asignan cada mañana: los más veteranos a los globos más grandes que pueden volar, los novatos a los pequeños. Los globos en reparación o con la envoltura gastada van al final."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パイロットは毎朝自動で割り振られる。ベテランは飛べる一番大きな気球へ、新人は小さな気球へ。修理中や球皮が寿命の気球は最後。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종사는 매일 아침 자동 배정됩니다. 베테랑은 뜰 수 있는 가장 큰 열기구에, 신입은 작은 열기구에. 수리 중이거나 외피가 다한 열기구는 마지막입니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilotlar her sabah otomatik dağıtılır: en kıdemliler uçabilecek en büyük balonlara, çaylaklar küçüklere. Onarımdaki ya da zarfı bitmiş balonlar en sona kalır."
          }
        }
      }
    },
    "crew.school": {
      "extractionState": "manual",
      "localizations": {
        "de": {
