    "goals.baronHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfülle alle am selben Tag, dann wirst du Baron von %@ und öffnest dich der Welt. Vorsicht: Die Wettbewerbsbehörde und fusionierende Konkurrenten werden dich aufhalten wollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet them all on the same day to become baron of %@ and open up to the world. Careful: the competition authority and merging rivals will try to stop you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cúmplelos todos el mismo día para convertirte en barón de %@ y abrirte al mundo. Cuidado: la autoridad de competencia y los rivales que se fusionen intentarán detenerte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてを同じ日に達成すれば%@の男爵となり、世界へ羽ばたける。気をつけろ、競争当局と合併するライバルが君を止めようとする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 같은 날 달성하면 %@의 남작이 되어 세계로 나아갑니다. 조심하세요: 경쟁 당국과 합병하는 경쟁사들이 당신을 막으려 할 겁니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsini aynı gün sağlarsan %@ baronu olur, dünyaya açılırsın. Dikkat: Rekabet Kurumu ve birleşen rakipler seni durdurmaya çalışacak."
          }
        }
      }
    },
    "goals.baronLead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel über %@ gehört dir. Neue Horizonte warten auf der Weltkarte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky over %@ is yours. New horizons await you on the world map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo de %@ es tuyo. Nuevos horizontes te esperan en el mapa del mundo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の空は君のものだ。新たな地平が世界地図で待っている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 하늘은 당신의 것입니다. 새로운 지평이 세계 지도에서 기다립니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ göğü senin. Yeni ufuklar dünya haritasında seni bekliyor."
          }
        }
      }
    },
