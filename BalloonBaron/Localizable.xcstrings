    "abq.mission.desc.valley": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinke über dem Rio Grande unter 150 m und grüße den Fluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop below 150 m over the Rio Grande and salute the river."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desciende por debajo de 150 m sobre el Río Grande y saluda al río."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リオグランデ川の上で高度150m以下まで下がり、川にあいさつしよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리오그란데강 위에서 150m 아래로 내려가 강에 인사하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rio Grande nehrinin üstünde 150 m altına alçal, nehri selamla."
          }
        }
      }
    },
