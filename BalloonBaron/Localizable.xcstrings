    "holding.enterSub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eintritt %1$@ aus der Holding. Du fängst bei null an: %2$@ und ein kleiner Ballon."
          }
        },
        "en": {
