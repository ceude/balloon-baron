    "repChart.crisisBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touristen meiden dich, Passagiere sind kaum zu finden. Mit den Maßnahmen unten erholst du dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourists avoid picking you and passengers are very hard to find. The actions below help you recover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los turistas evitan elegirte y cuesta mucho encontrar pasajeros. Con las acciones de abajo puedes recuperarte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観光客に避けられ、乗客がほとんど集まらない。下の手段で立て直そう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관광객이 당신을 피해서 승객을 찾기가 매우 어렵습니다. 아래 방법으로 회복할 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Turistler seni seçmekten kaçınıyor, yolcu bulmak çok zor. Aşağıdakilerle toparlayabilirsin."
          }
        }
      }
    },
