    "trait.daredevil.d": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "30 % mehr Unfallrisiko, aber die Fahrgäste lieben es: Beliebtheit bei jedem Flug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30% higher accident risk, but passengers love it: popularity on every flight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 30 % más de riesgo, pero a los pasajeros les encanta: popularidad en cada vuelo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事故リスク30%増。でも乗客は大喜び：毎回人気アップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사고 위험 30% 증가. 하지만 승객들이 열광: 매 비행마다 인기 상승."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaza riski %30 yüksek, ama yolcular bayılır: her uçuşta popülerlik."
          }
        }
      }
    },
