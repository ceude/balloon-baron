    "home.alert.winter.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur halb so viele Touristen, und rote Flaggen sind häufig. Lass überzählige Ballone am Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half as many tourists, and red flags are common. Keep spare balloons on the ground."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mitad de turistas y muchas banderas rojas. Deja en tierra los globos que sobran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観光客は半分、赤い旗も多い。余分な気球は地上に置いておこう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관광객은 절반, 빨간 깃발도 잦습니다. 남는 열기구는 지상에 두세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
