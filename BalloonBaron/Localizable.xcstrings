        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu licencia de piloto caduca hoy. Mañana no podrás pilotar el globo insignia; renuévala en la pestaña Equipo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操縦免許は今日で切れる。明日は旗艦を自分で飛ばせない。乗組員タブで更新しよう。"
