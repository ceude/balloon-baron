    "marketPage.removeAdsBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ballone mit Werbung: %@. Entfernst du sie, enden die Werbeeinnahmen und der Beliebtheitsverlust hört auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balloons with ads: %@. Removing them ends the ad income and stops the popularity loss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Globos con anuncios: %@. Si los quitas, se acaban los ingresos por publicidad y se detiene la pérdida de popularidad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告付きの気球：%@。外すと広告収入はなくなるが、人気の低下は止まる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고가 달린 열기구: %@. 제거하면 광고 수입이 끊기고 인기 하락이 멈춥니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamlı balon: %@. Kaldırırsan reklam geliri biter, popülerlik kaybı durur."
          }
        }
      }
    },
    "marketPage.rivalTips": {
      "extractionState": "manual",
      "localizations": {
