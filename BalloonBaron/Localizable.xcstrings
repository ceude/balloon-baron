    "home.alert.trap": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lizenz ist abgelaufen und dein Flaggschiff kann nicht fliegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your license has expired and your flagship can't fly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu licencia ha caducado y tu globo insignia no puede volar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "免許が切れ、旗艦も飛べない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면허가 만료됐고 기함도 뜰 수 없습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisansın doldu ve amiral balonun uçamıyor."
          }
        }
      }
    },
    "home.alert.trap.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst keinen Erneuerungsflug machen: Mach einen anderen Ballon zum Flaggschiff oder zahle %@ für die Lizenz. Tippe für die Flotte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't make a renewal flight: make another balloon your flagship, or pay %@ to renew the license. Tap for the fleet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes hacer el vuelo de renovación: haz insignia a otro globo o paga %@ para renovar la licencia. Toca para ver la flota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新フライトはできない。別の気球を旗艦にするか、%@を払って免許を更新しよう。タップでフリートへ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갱신 비행을 할 수 없습니다. 다른 열기구를 기함으로 지정하거나 %@를 내고 면허를 갱신하세요. 탭하면 기단으로 갑니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenileme uçuşu yapamazsın: başka bir balonu amiral yap ya da %@ ödeyip lisansı yenile. Filo için dokun."
          }
        }
      }
    },
    "home.alert.trap.bodyWorn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst keinen Erneuerungsflug machen: Erneuere die Hülle, mach einen anderen Ballon zum Flaggschiff oder zahle %@ für die Lizenz. Tippe für die Flotte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't make a renewal flight: renew its envelope, make another balloon your flagship, or pay %@ to renew the license. Tap for the fleet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes hacer el vuelo de renovación: renueva su envoltura, haz insignia a otro globo o paga %@ para renovar la licencia. Toca para ver la flota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新フライトはできない。球皮を張り替えるか、別の気球を旗艦にするか、%@を払って免許を更新しよう。タップでフリートへ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갱신 비행을 할 수 없습니다. 외피를 교체하거나, 다른 열기구를 기함으로 지정하거나, %@를 내고 면허를 갱신하세요. 탭하면 기단으로 갑니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenileme uçuşu yapamazsın: zarfını yenile, başka bir balonu amiral yap ya da %@ ödeyip lisansı yenile. Filo için dokun."
          }
        }
      }
    },
    "home.alert.trap.damaged": {
      "extractionState": "manual",
      "localizations": {
        "de": {
