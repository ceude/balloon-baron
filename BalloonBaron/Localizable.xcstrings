      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schöner Flug, aber laut Prospekt sollte der Gründer selbst fliegen. Den haben wir nie gesehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice flight, but the brochure promised the founder would be our pilot. We never saw them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen vuelo, pero el folleto prometía que el fundador sería el piloto. Nunca lo vimos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フライトは良かったが、パンフレットには創業者が操縦すると書いてあった。一度も見なかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비행은 좋았지만 브로슈어에는 창업자가 직접 조종한다고 쓰여 있었어요. 한 번도 못 봤어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçuş güzeldi ama broşürde kurucunun bizzat pilotluk yaptığı yazıyordu. Hiç görmedik."
          }
        }
      }
    },
    "review.absent.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es fühlt sich jetzt wie eine Fabrik an. Der Geist des Familienbetriebs ist weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It feels like a factory now. The family company spirit is gone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora parece una fábrica. Ya no queda el espíritu de empresa familiar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今では工場のよう。家族経営の雰囲気はもうない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 공장 같아요. 가족 회사 분위기가 사라졌어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık fabrika gibi olmuş. Aile şirketi havası kalmamış."
          }
        }
      }
    },
    "review.accident.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir waren in {b} und sind sehr hart gelandet. Niemand hat sich richtig um uns gekümmert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We were on {b} and came down really hard. Nobody properly looked after us."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Íbamos en el {b} y aterrizamos muy fuerte. Nadie se ocupó de nosotros como es debido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{b}に乗っていたが、すごく強く着地した。誰もまともに対応してくれなかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{b}에 탔는데 엄청 세게 착륙했어요. 아무도 제대로 챙겨 주지 않았어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{b} balonundaydık, çok sert indik. Kimse doğru düzgün ilgilenmedi."
          }
        }
      }
    },
    "review.accident.1": {
      "extractionState": "manual",
      "localizations": {
