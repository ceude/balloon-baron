    "chapter.fiesta.award": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Jury der Balloon Fiesta kürte dich zum Star der Fiesta"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Balloon Fiesta jury named you Star of the Fiesta"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jurado de la Balloon Fiesta te nombró Estrella de la Fiesta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バルーン・フィエスタの審査員が君をフィエスタのスターに選んだ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벌룬 피에스타 심사위원단이 당신을 피에스타의 스타로 선정했습니다"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balloon Fiesta jürisi seni Fiesta'nın Yıldızı seçti"
          }
        }
      }
    },
