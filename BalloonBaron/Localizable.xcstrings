        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새벽 4시에 일어났는데 열기구가 뜨지도 않았어요. 보상은 받았지만 실망이에요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah 4'te kalktık, balon hiç havalanmadı. Tazminat verdiler ama hayal kırıklığı."
          }
        }
      }
    },
    "review.cancel.1": {
