    "marketPage.yesterdayExtra": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touristen, die gestern fahren wollten: %1$@. Direkt über Empfehlungen zu dir: %2$@. Geflogen: %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
