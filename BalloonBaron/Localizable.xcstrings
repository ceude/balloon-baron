    "cover.all": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Versicherung hat alles bezahlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insurance paid for everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguro lo pagó todo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保険がすべて支払った。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보험이 모두 보상했습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigorta tamamını ödedi."
          }
        }
      }
    },
    "cover.hullOnly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Versicherung zahlte die Reparatur, die Entschädigung kam aus deiner Kasse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insurance paid the repairs; compensation came out of your cash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguro pagó la reparación; la indemnización salió de tu caja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修理は保険、補償は自腹。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수리는 보험, 보상금은 금고에서 나갔습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigorta onarımı ödedi, tazminat kasadan çıktı."
          }
        }
      }
    },
    "cover.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Versicherung: Alles ging aus deiner Kasse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No insurance: it all came out of your cash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin seguro: todo salió de tu caja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保険なし。すべて自腹。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보험이 없어 모두 금고에서 나갔습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigorta yoktu, hepsi kasadan çıktı."
          }
        }
      }
    },
    "cover.paxOnly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Versicherung zahlte die Entschädigung, die Reparatur kam aus deiner Kasse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insurance paid the compensation; repairs came out of your cash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguro pagó la indemnización; la reparación salió de tu caja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補償は保険、修理は自腹。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보상금은 보험, 수리비는 금고에서 나갔습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigorta tazminatı ödedi, onarım kasadan çıktı."
          }
        }
      }
    },
