    "red.fine": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Risiko für %2$@ Strafe und eine Verwarnung. Verwarnungen bisher: %3$@/3. Bei der dritten gibt es 3 Tage Flugverbot."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chance of a %2$@ fine and a strike. Strikes so far: %3$@/3. The third brings a 3-day flying ban."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de probabilidad de una multa de %2$@ y un aviso. Avisos hasta ahora: %3$@/3. Con el tercero llegan 3 días sin volar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の確率で%2$@の罰金と警告。現在の警告：%3$@/3。3回目で3日間の飛行禁止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 확률로 %2$@ 벌금과 경고를 받습니다. 현재 경고: %3$@/3. 세 번째에는 3일 비행 금지가 내려집니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ihtimalle %2$@ ceza ve bir uyarı alırsın. Şu anki uyarı: %3$@/3. Üçüncüsünde 3 gün uçuş yasağı gelir."
          }
        }
      }
    },
    "red.fly": {
