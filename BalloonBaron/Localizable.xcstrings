    "event.envelopeWorn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hülle von %@ ist verschlissen. Ohne Erneuerung kein Flug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The envelope of %@ is worn out. It can't fly until renewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La envoltura de %@ está desgastada. No podrá volar hasta renovarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の球皮が寿命を迎えた。張り替えるまで飛べない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 열기구의 외피 수명이 다했습니다. 교체 전에는 비행할 수 없습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ balonunun zarfı ömrünü doldurdu. Yenilenmeden uçamaz."
          }
        }
      }
    },
    "event.farLanding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Du bist %2$@ m vom Ziel gelandet, die Bodencrew hat dich spät gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: you landed %2$@ m from the target and the ground crew was late to find you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: aterrizaste a %2$@ m del objetivo y el equipo de tierra tardó en encontrarte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：目標から%2$@ m離れて着陸。地上クルーの到着が遅れた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 목표에서 %2$@ m 떨어진 곳에 착륙해 지상 요원이 늦게 찾았습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: hedeften %2$@ m uzağa indin, yer ekibi seni geç buldu."
          }
        }
      }
    },
    "event.founderAbsent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst seit %@ Tagen nicht im Korb. Die Passagiere fragen nach dem Gründer, die Beliebtheit bröckelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't been in a basket for %@ days. Passengers keep asking for the founder, and popularity is slipping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas %@ días sin subir a una cesta. Los pasajeros preguntan por el fundador y la popularidad cae."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@日間バスケットに乗っていない。乗客は創業者を探し、人気が落ちている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@일째 바스켓에 타지 않았습니다. 승객들이 창업자를 찾고 인기가 떨어지고 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gündür sepete binmedin. Yolcular kurucuyu soruyor, popülerlik eriyor."
          }
        }
      }
    },
    "event.goodLanding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: saubere Landung, zufriedene Passagiere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: smooth landing, happy passengers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: buen aterrizaje, pasajeros contentos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：スムーズな着陸。乗客は満足。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 부드러운 착륙, 승객 만족."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: düzgün iniş, yolcular memnun."
          }
        }
      }
    },
    "event.hotelLeft": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Vertrag beendet. Deine Beliebtheit ist zu weit unter sein Niveau gefallen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ended the deal. Your popularity fell too far below its level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminó el acuerdo. Tu popularidad cayó muy por debajo de su nivel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が契約を打ち切った。人気がホテルの水準を大きく下回った。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 측이 제휴를 끝냈습니다. 인기가 호텔 수준보다 너무 낮아졌습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ anlaşmayı bitirdi. Popülerliğin otelin seviyesinin çok altına düştü."
          }
        }
      }
    },
    "event.licenseExpiring": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pilotenlizenz läuft heute ab. Morgen darfst du das Flaggschiff nicht selbst fliegen; erneuere sie im Crew-Tab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pilot license expires today. Tomorrow you can't fly the flagship yourself; renew it in the Crew tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu licencia de piloto caduca hoy. Mañana no podrás pilotar el globo insignia; renuévala en la pestaña Equipo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操縦免許は今日で切れる。明日は旗艦を自分で飛ばせない。乗組員タブで更新しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종 면허가 오늘 만료됩니다. 내일은 기함을 직접 조종할 수 없으니 승무원 탭에서 갱신하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot lisansın bugün sona eriyor. Yarın amiral balonunu kendin uçuramazsın; Ekip sekmesinden yenileyebilirsin."
          }
        }
      }
    },
    "event.licenseRenewedByFlight": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Erneuerungsflug selbst gemacht. Lizenz erneuert, deine Ballone dürfen wieder starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You flew the renewal flight yourself. License renewed, your balloons can take off again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiciste tú mismo el vuelo de renovación. Licencia renovada; tus globos pueden volver a despegar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新フライトを自分で飛んだ。免許が更新され、気球はまた飛べる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갱신 비행을 직접 마쳤습니다. 면허가 갱신되어 열기구들이 다시 이륙할 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenileme uçuşunu kendin yaptın. Lisansın yenilendi, balonların yeniden kalkabilir."
          }
        }
      }
    },
    "event.missionDone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auftrag erfüllt: %1$@. Der Kunde zahlte %2$@ Belohnung."
          }
