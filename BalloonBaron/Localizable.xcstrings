    "review.accident.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir waren in {b} und sind sehr hart gelandet. Niemand hat sich richtig um uns gekümmert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We were on {b} and came down really hard. Nobody properly looked after us."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Íbamos en el {b} y aterrizamos muy fuerte. Nadie se ocupó de nosotros como es debido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{b}に乗っていたが、すごく強く着地した。誰もまともに対応してくれなかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{b}에 탔는데 엄청 세게 착륙했어요. 아무도 제대로 챙겨 주지 않았어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{b} balonundaydık, çok sert indik. Kimse doğru düzgün ilgilenmedi."
          }
        }
      }
    },
    "review.accident.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Landung von {b} war schrecklich. Der Pilot wirkte sehr unerfahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The landing on {b} was terrible. The pilot looked very inexperienced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aterrizaje del {b} fue terrible. El piloto parecía muy inexperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{b}の着陸はひどかった。パイロットはかなり未熟に見えた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{b}의 착륙은 끔찍했어요. 조종사가 너무 미숙해 보였어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{b} balonunun inişi korkunçtu. Pilot çok tecrübesiz görünüyordu."
          }
        }
      }
    },
    "review.ad.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Ballon prangte riesige Werbung für {s}, sie ist auf all meinen Fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was a huge {s} ad on the balloon, and it's in all my photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el globo había un enorme anuncio de {s} y sale en todas mis fotos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気球に巨大な{s}の広告があって、全部の写真に写り込んだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기구에 거대한 {s} 광고가 있어서 모든 사진에 찍혔어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balonun üstünde kocaman bir {s} reklamı vardı, bütün fotoğraflarıma girdi."
          }
        }
      }
    },
    "review.ad.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Flug war schön, aber die Werbung für {s} hat die Romantik etwas zerstört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flight was nice, but the {s} ad kind of killed the romance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vuelo fue bonito, pero el anuncio de {s} mató un poco el romanticismo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フライトは良かったが、{s}の広告でロマンチックさが台無し。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비행은 좋았지만 {s} 광고 때문에 낭만이 좀 깨졌어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçuş güzeldi ama {s} reklamı romantizmi biraz öldürdü."
          }
        }
      }
    },
    "review.ad.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Traum-Ballonfahrt fand unter einer Werbetafel statt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My dream balloon ride happened under a billboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paseo en globo de mis sueños fue bajo una valla publicitaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢の気球ツアーは広告看板の下で終わった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈꾸던 열기구 투어가 광고판 아래에서 끝났어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayalimdeki balon turu bir reklam panosunun altında geçti."
          }
        }
      }
    },
    "review.cancel.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um 4 Uhr aufgestanden, und der Ballon hob nie ab. Sie haben entschädigt, aber was für eine Enttäuschung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We got up at 4 a.m. and the balloon never took off. They compensated us, but what a letdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos levantamos a las 4 y el globo nunca despegó. Nos indemnizaron, pero qué decepción."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝4時に起きたのに気球は飛ばなかった。補償はあったけど残念。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새벽 4시에 일어났는데 열기구가 뜨지도 않았어요. 보상은 받았지만 실망이에요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah 4'te kalktık, balon hiç havalanmadı. Tazminat verdiler ama hayal kırıklığı."
          }
        }
      }
    },
    "review.cancel.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Flug wurde in letzter Minute abgesagt. Immerhin gab es sofort Geld zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flight was cancelled at the last minute. At least they refunded us immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vuelo se canceló en el último minuto. Al menos nos devolvieron el dinero al instante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前でフライト中止。少なくともすぐ返金してくれた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막판에 비행이 취소됐어요. 그래도 바로 환불은 해 줬어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçuş son anda iptal edildi. En azından paramızı hemen iade ettiler."
          }
        }
      }
    },
