        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{d}\" era el globo más bonito del cielo. Ir dentro fue un privilegio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空でいちばん美しい気球は「{d}」だった。乗れて光栄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘에서 가장 아름다운 열기구는 '{d}'였어요. 타는 것만으로 특별했어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gökyüzündeki en güzel balon \"{d}\" idi, içinde olmak ayrıcalıktı."
          }
        }
      }
    },
