    "home.alert.festival.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele Touristen, und Sonderwünsche zahlen 50 % mehr."
          }
        },
