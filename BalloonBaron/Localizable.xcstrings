    "marketPage.influencerBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reise-Influencer fliegen mit dir und posten darüber. Sofort +0,4★, an den nächsten 3 Tagen je +0,1★ mehr, und ihre Follower kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel influencers fly with you and post about it. +0.4★ right away, another +0.1★ each of the next 3 days, and their followers come."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Influencers de viajes vuelan contigo y lo publican. +0,4★ al instante, +0,1★ más cada uno de los 3 días siguientes, y llegan sus seguidores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行インフルエンサーが一緒に飛んで投稿する。すぐに+0.4★、続く3日間は毎日さらに+0.1★、フォロワーもやって来る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 인플루언서가 함께 비행하고 게시물을 올립니다. 즉시 +0.4★, 이후 3일 동안 매일 +0.1★씩 더, 그리고 팔로워들이 찾아옵니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezi influencerları seninle uçup paylaşır. Hemen +0,4★, sonraki 3 gün her gün +0,1★ daha ve takipçileri gelir."
          }
        }
      }
    },
