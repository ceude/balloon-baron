    "chapter.founding.award": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tourismusverband Kappadokien kürte dich zum Jungunternehmer des Jahres"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cappadocia Tourism Association named you young entrepreneur of the year"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Asociación de Turismo de Capadocia te nombró joven emprendedor del año"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カッパドキア観光協会が君を年間最優秀若手起業家に選んだ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카파도키아 관광협회가 당신을 올해의 청년 기업가로 선정했습니다"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapadokya Turizm Derneği seni yılın genç girişimcisi seçti"
          }
        }
      }
    },
