    "issue.hotel.hez": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotels sind nicht treu, Lehrling, aber eine kleine Geste genügt meistens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotels aren't loyal, kid, but a small gesture is usually enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hoteles no son leales, aprendiz, pero un pequeño gesto suele bastar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホテルに忠誠心はない。だが小さな心づけで大抵は足りる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호텔은 의리가 없다네. 하지만 작은 성의면 대개 충분하지."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oteller sadık değildir evlat, ama küçük bir jest çoğu zaman yeter."
          }
        }
      }
    },
