    "home.licenseExpired": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lizenz ist abgelaufen: Deine anderen Ballone bleiben am Boden. Flieg heute selbst das Flaggschiff (kostenloser Erneuerungsflug) oder zahle %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your license has expired: your other balloons are grounded. Fly the flagship yourself today (free renewal flight) or pay %@ to renew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu licencia ha caducado: tus otros globos están en tierra. Pilota hoy tú mismo el globo insignia (vuelo de renovación gratuito) o paga %@ para renovarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "免許が切れた：ほかの気球は飛べない。今日、旗艦を自分で飛ばす（無料の更新フライト）か、%@を払って更新しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면허가 만료되어 다른 열기구는 운항할 수 없습니다. 오늘 기함을 직접 조종하거나(무료 갱신 비행) %@를 내고 갱신하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisansın doldu: diğer balonların yerde. Bugün amiral balonunu kendin uçur (ücretsiz yenileme uçuşu) ya da %@ ödeyip yenile."
          }
        }
      }
    },
    "home.mission": {
