    "store.lead.decor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein bleibender Schmuck für deine Stadt. Auf dem Basar gekauft, in der Stadt zu sehen, und nachts leuchtet er."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lasting decoration for your town. Bought at the bazaar, seen in town, and it lights up at night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adorno permanente para tu pueblo. Se compra en el bazar, se ve en el pueblo y se ilumina de noche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "町に残る飾り。バザールで買えて町に飾られ、夜には光る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마을에 남는 장식. 시장에서 사면 마을에 보이고 밤에는 불이 켜집니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasabana kalıcı bir süs. Çarşıdan alınır, şehirde görünür, gece de ışıl ışıl yanar."
          }
        }
      }
    },
    "store.lead.pattern": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein besonderes Muster. Es kommt als fertiges Design und geht direkt auf dein Flaggschiff. Hohe Kreativität, verblasst nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A special pattern. It comes as a ready design and goes straight onto your flagship. High creativity score, never fades."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un diseño especial. Llega listo y va directo a tu globo insignia. Mucha creatividad y nunca pierde frescura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特別な柄。完成デザインとして届き、すぐ旗艦に着せられる。創造性が高く、色あせない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특별 무늬. 완성 디자인으로 와서 바로 기함에 입혀집니다. 창의성 점수가 높고 바래지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel desen. Hazır tasarımıyla gelir, amiral balonuna hemen giydirilir. Yaratıcılık puanı yüksek, hiç eskimez."
          }
        }
      }
    },
    "store.lead.shape": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine besonders geformte Hülle. Sie kommt als fertiges Design und geht direkt auf dein Flaggschiff; zusätzliche Beliebtheit bei jedem Flug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A specially shaped envelope. It comes as a ready design and goes straight onto your flagship; extra popularity on every flight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una envoltura con forma especial. Llega lista y va directa a tu globo insignia; popularidad extra en cada vuelo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特別な形の球皮。完成デザインとして届き、すぐ旗艦に着せられる。毎回の飛行で人気アップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특별한 모양의 외피. 완성 디자인으로 와서 바로 기함에 입혀지며 매 비행마다 추가 인기를 줍니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel şekilli balon zarfı. Hazır tasarımıyla gelir, amiral balonuna hemen giydirilir; her uçuşta ekstra popülerlik getirir."
          }
        }
      }
    },
    "store.nightPreview": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So sieht deine Stadt nachts aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your town will look like this at night"
          }
        },
        "es": {
