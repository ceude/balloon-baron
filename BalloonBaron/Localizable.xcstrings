    "report.holdBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat im Autopilot verdient; die Holding-Ausgaben (%2$@) sind abgezogen. Holding-Kasse: %3$@."
          }
        },
        "en": {
          "stringUnit": {
