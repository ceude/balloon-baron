    "fleetPage.workshopDesc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du entwirfst die Muster deiner Ballone selbst. Kreative Designs ziehen die Blicke der Passagiere an und bringen Beliebtheit. Die Werkstatt wird einmal gebaut, deine Designs gelten in allen Regionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Design your balloons' patterns yourself. Creative designs catch passengers' eyes and bring popularity. The workshop is built once; your designs work in every region."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseñas tú mismo los estampados de tus globos. Los diseños creativos llaman la atención de los pasajeros y dan popularidad. El taller se construye una vez y tus diseños sirven en todas las regiones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気球の柄を自分でデザインできる。独創的なデザインは乗客の目を引き、人気をもたらす。工房は一度建てればよく、デザインはすべての地域で使える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기구 무늬를 직접 디자인합니다. 창의적인 디자인은 승객의 눈길을 끌고 인기를 가져옵니다. 공방은 한 번만 세우면 되고, 디자인은 모든 지역에서 쓸 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balonlarının desenlerini kendin tasarlarsın. Yaratıcı tasarımlar yolcuların ilgisini çeker ve popülerlik getirir. Atölye bir kez kurulur, tasarımların bütün bölgelerde kullanılır."
          }
        }
      }
    },
    "fleetPage.xlDesc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinen Farben, der größte Ballon am Himmel. Jeder Flug bringt +0,02★ Beliebtheit und Passagierbewertungen. Du kannst nur einen bauen lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your colours, the biggest balloon in the sky. Every flight brings +0.02★ popularity and passenger reviews. You can only have one built."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tus colores, el globo más grande del cielo. Cada vuelo aporta +0,02★ de popularidad y reseñas de pasajeros. Solo puedes encargar uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのカラーで作る、空でいちばん大きな気球。フライトごとに人気+0.02★と乗客のレビューをもたらす。作れるのは1機だけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 색으로 만든 하늘에서 가장 큰 열기구. 비행할 때마다 인기 +0.02★와 승객 후기를 가져옵니다. 단 한 대만 만들 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senin renklerinde, gökyüzünün en büyük balonu. Her uçuşta +0,02★ popülerlik ve yolcu yorumları getirir. Sadece bir tane yaptırabilirsin."
          }
        }
      }
    },
    "fleetPage.yours": {
