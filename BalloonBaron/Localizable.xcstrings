    "setup.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel über Kappadokien wartet. Wie sollen dich die Touristen nennen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cappadocia's sky is waiting. What will tourists call you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo de Capadocia te espera. ¿Cómo te llamarán los turistas?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カッパドキアの空が待っている。観光客にどう呼ばれたい？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카파도키아의 하늘이 기다립니다. 관광객들이 당신을 뭐라고 부를까요?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapadokya'nın göğü seni bekliyor. Turistler sana ne diyecek?"
          }
        }
      }
    },
