        }
      }
    },
    "review.precision.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pilot setzte den Ballon direkt neben den Anhänger. Wir mussten keinen Schritt gehen!"
          }
        },
        "en": {
          "stringUnit": {
