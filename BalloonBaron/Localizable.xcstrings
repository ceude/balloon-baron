    "issue.raise.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Piloten wollen eine Gehaltserhöhung, sonst fliegen sie drei Tage nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pilots want a raise, or they won't fly for three days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pilotos quieren un aumento o no volarán durante tres días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パイロットが昇給を求めている。さもなくば3日間飛ばないそうだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종사들이 임금 인상을 요구합니다. 아니면 3일간 비행하지 않겠답니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilotlar maaşlarına zam istiyor, yoksa üç gün uçmayacaklarmış."
          }
        }
      }
    },
    "issue.raise.hez": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Piloten fliegt kein Ballon, Lehrling. Eine Erhöhung ist meist billiger als ein Streik."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No balloon flies without a pilot, kid. A raise is usually cheaper than a strike."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin piloto no vuela ningún globo, aprendiz. Un aumento suele salir más barato que una huelga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パイロットなしに気球は飛ばん。昇給はたいていストより安くつくぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종사 없이는 열기구가 못 뜬다네. 인상이 대개 파업보다 싸지."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilotsuz balon uçmaz evlat. Zam çoğu zaman greve göre ucuzdur."
          }
        }
      }
    },
