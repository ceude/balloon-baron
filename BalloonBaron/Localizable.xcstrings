    "office.tyo.perk": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Designs kostenlos, Kreativität +10, Designs bleiben 60 Tage frisch. Einstieg in Asien zum halben Preis."
          }
        },
