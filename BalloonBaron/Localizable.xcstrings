    "review.general.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aufstehen um 4 Uhr hat sich gelohnt. Der Himmel war voller Ballone."
          }
