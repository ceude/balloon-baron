    "event.hotelLeft": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Vertrag beendet. Deine Beliebtheit ist zu weit unter sein Niveau gefallen."
