          }
        }
      }
    },
    "deal.short": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@ in der Kasse. Nimm einen Kredit auf und kauf später über die Markt-Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %@ in cash. Take a bank loan, then buy it later from the Market page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %@ en caja. Pide un préstamo y cómpralo luego desde la página Mercado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手元資金は%@。銀行で借りて、あとで市場ページから買えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금고에 %@ 있습니다. 은행에서 대출받은 뒤 시장 페이지에서 살 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
