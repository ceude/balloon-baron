            "state": "translated",
            "value": "La envoltura de %@ está desgastada. No podrá volar hasta renovarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の球皮が寿命を迎えた。張り替えるまで飛べない。"
          }
        },
        "ko": {
