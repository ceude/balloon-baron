    "deal.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagst du später, wartet das Angebot auf der Markt-Seite. Bis du ablehnst oder annimmst, bleibt ein roter Punkt am Markt-Knopf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you say later, the offer waits on the Market page. A red dot stays on the Market button until you decline or accept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dices luego, la oferta espera en la página Mercado. Un punto rojo queda en el botón Mercado hasta que la rechaces o aceptes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとでにすると、提案は市場ページで待っています。断るか受けるまで、市場ボタンに赤い点が残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에를 누르면 제안은 시장 페이지에서 기다립니다. 거절하거나 수락할 때까지 시장 버튼에 빨간 점이 남습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra dersen teklif Pazar sayfasında bekler. Reddedene ya da kabul edene kadar Pazar düğmesinde kırmızı nokta kalır."
          }
        }
      }
    },
    "deal.later": {
