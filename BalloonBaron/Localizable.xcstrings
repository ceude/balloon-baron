    "town.card.locked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gebäude öffnet an Tag %@. Bis dahin flieg weiter mit deinem ersten Ballon, Lehrling."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This building opens on day %@. Until then, keep flying your first balloon, kid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este edificio abre el día %@. Hasta entonces, sigue volando tu primer globo, aprendiz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この建物は%@日目に開く。それまでは最初の気球で飛び続けるのだ、弟子よ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 건물은 %@일차에 열리네. 그때까지 첫 열기구로 계속 날게, 제자여."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bina %@. günde açılır. O zamana kadar ilk balonunla uçmaya devam et evlat."
          }
        }
      }
    },
