    "fleetPage.adLead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sponsor zahlt jeden Flug. Passagiere mögen keine Werbeballone, deine Beliebtheit sinkt mit jedem Flug ein wenig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sponsor pays every flight. Passengers dislike ad-covered balloons; your popularity drops a little each flight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El patrocinador paga cada vuelo. A los pasajeros no les gustan los globos con publicidad; tu popularidad baja un poco en cada vuelo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スポンサーはフライトごとに払う。乗客は広告付きの気球を好まず、フライトごとに人気が少し下がる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스폰서는 비행마다 돈을 냅니다. 승객은 광고 열기구를 싫어해서 비행마다 인기가 조금씩 떨어집니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sponsor her uçuşta öder. Yolcular reklamlı balonu sevmez, popülerliğin her uçuşta biraz düşer."
          }
        }
      }
    },
    "fleetPage.adMinL": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitet nur mit großen Körben."
