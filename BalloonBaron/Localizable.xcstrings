    "fleetPage.hintEnvelope": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ballonhülle verschleißt nach etwa %@ Flügen. Unter 30 %% steigt das Unfallrisiko, bei 0 %% kann der Ballon nicht fliegen. Erneuern kostet 35 %% des Ballonpreises."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A balloon envelope wears out after about %@ flights. Below 30%% the accident risk rises; at 0%% the balloon can't fly. Renewing costs 35%% of the balloon's price."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La envoltura de un globo se desgasta tras unos %@ vuelos. Por debajo del 30 %% sube el riesgo de accidente; al 0 %% el globo no puede volar. Renovarla cuesta el 35 %% del precio del globo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気球のエンベロープは約%@回のフライトで消耗する。30%%を下回ると事故リスクが上がり、0%%では飛べない。交換費用は気球価格の35%%。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기구 외피는 약 %@회 비행하면 낡습니다. 30%% 아래로 떨어지면 사고 위험이 커지고, 0%%가 되면 비행할 수 없습니다. 교체 비용은 열기구 가격의 35%%입니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balon zarfı yaklaşık %@ uçuşta yıpranır. %%30 altında kaza riski artar, %%0'da balon uçamaz. Yenilemek balon fiyatının %%35'i."
          }
        }
      }
    },
    "fleetPage.hintPilots": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Flaggschiff fliegst du selbst. Die anderen Ballone brauchen einen Piloten. Mit Werbung auf einem Ballon zahlt der Sponsor jeden Flug, aber Passagiere mögen keine Werbeballone und deine Beliebtheit sinkt mit jedem Flug ein wenig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You fly the flagship yourself. Other balloons need a pilot. If you put an ad on a balloon, the sponsor pays every flight, but passengers dislike ad-covered balloons and your popularity drops a little each flight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El globo insignia lo pilotas tú. Los demás globos necesitan un piloto. Si pones un anuncio en un globo, el patrocinador paga cada vuelo, pero a los pasajeros no les gustan los globos con publicidad y tu popularidad baja un poco en cada vuelo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旗艦はあなたが自分で飛ばす。ほかの気球にはパイロットが必要。気球に広告を載せるとスポンサーが毎回払ってくれるが、乗客は広告付きの気球を好まず、フライトごとに人気が少し下がる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기함은 직접 조종합니다. 다른 열기구에는 조종사가 필요합니다. 열기구에 광고를 달면 스폰서가 비행마다 돈을 내지만, 승객은 광고 열기구를 싫어해서 비행할 때마다 인기가 조금씩 떨어집니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amiral balonunu sen uçurursun. Diğer balonlara pilot gerekir. Balonuna reklam alırsan sponsor her uçuşta öder, ama yolcular reklamlı balonu sevmez ve popülerliğin her uçuşta biraz düşer."
          }
        }
      }
    },
