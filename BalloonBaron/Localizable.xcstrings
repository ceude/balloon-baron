    "event.rivalForSale": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ steckt in Schwierigkeiten. Du kannst ein Übernahmeangebot machen: %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is struggling. You can make a takeover offer: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está en apuros. Puedes hacer una oferta de compra: %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は苦境にある。買収を提案できる：%2$@。"
