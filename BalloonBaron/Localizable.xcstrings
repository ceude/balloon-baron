    "night.shooting": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sternschnuppe! Vergiss nicht, dir etwas zu wünschen, Lehrling."
