    "flight.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Flugszene kommt im nächsten Build. Wähle vorerst, wie die Landung lief."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flight scene arrives in the next build. For now, pick how the landing went."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escena de vuelo llega en la próxima versión. Por ahora, elige cómo fue el aterrizaje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飛行シーンは次のビルドで追加。今は着陸結果を選んでね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비행 장면은 다음 빌드에 추가됩니다. 지금은 착륙 결과를 고르세요."
          }
        },
        "tr": {
          "stringUnit": {
