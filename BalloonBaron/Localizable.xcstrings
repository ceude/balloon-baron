    "issue.envelope.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ballonhüllen verschleißen, der Manager will ein Budget für neue."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balloon envelopes are wearing out and the manager wants a renewal budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las envolturas se desgastan y el gerente pide presupuesto para renovarlas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "球皮が傷んできて、マネージャーが交換予算を求めている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기구 외피가 낡아 매니저가 교체 예산을 요청합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balonların zarfları yıpranıyor, müdür yenileme bütçesi istiyor."
          }
        }
      }
    },
    "issue.envelope.hez": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alter Stoff lädt bei starkem Wind zu Unfällen ein, vergiss das nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old fabric invites accidents in strong winds. Don't forget that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tela vieja invita a accidentes con viento fuerte, no lo olvides."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い布は強風で事故を招く。忘れるな。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낡은 천은 강풍에 사고를 부른다네, 잊지 말게."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski kumaş sert rüzgârda kazaya davetiyedir, unutma."
          }
        }
      }
    },
    "issue.hotel": {
