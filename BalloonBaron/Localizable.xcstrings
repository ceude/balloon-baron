            "value": "Görev başarıldı! +%@"
          }
        }
      }
    },
    "flight.moment.greet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr habt dem Nachbarballon zugewinkt! Die Fahrgäste sind begeistert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You waved to the neighbouring balloon! The passengers are delighted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Saludasteis al globo vecino! Los pasajeros están encantados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隣の気球に手を振った！乗客は大喜び。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이웃 열기구에 손을 흔들었다! 승객들이 무척 기뻐합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komşu balonla el salladınız! Yolcular çok sevindi."
          }
        }
      }
    },
    "flight.moment.photo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonnenaufgangsbild! Alle werden die Fahrgäste um dieses Foto beneiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise shot! Everyone will envy the passengers' photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Foto del amanecer! Todos envidiarán la foto de los pasajeros."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の出の一枚！乗客の写真はみんなの羨望の的。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일출 사진! 모두가 승객의 사진을 부러워할 겁니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün doğumu karesi! Yolcuların fotoğrafı herkesi kıskandıracak."
          }
        }
      }
    },
    "flight.moment.thermal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Thermik erwischt! Warme Luft trug dich kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You caught a thermal! Warm air carried you for free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Atrapaste una térmica! El aire caliente te llevó gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上昇気流をつかんだ！暖かい空気がただで運んでくれた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상승기류를 탔다! 따뜻한 공기가 공짜로 데려다줬습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termik yakaladın! Sıcak hava seni bedavaya taşıdı."
          }
        }
      }
    },
