    "marketPage.style.safe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorsichtig und teuer. Bei gelber Flagge fliegt die Hälfte der Flotte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Careful and expensive. On a yellow flag it flies half its fleet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prudente y cara. Con bandera amarilla vuela con la mitad de su flota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "慎重で高価格。黄色の旗の日は保有気球の半分で飛ぶ。"
