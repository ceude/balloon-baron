    "home.redConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "35 %% Risiko für %@ Strafe und eine Verwarnung. Die Versicherung zahlt nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "35%% chance of a %@ fine and a strike. Insurance won't pay for anything."
