    "trait.storyteller.d": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzählt Kappadokiens Legenden: glänzende Bewertungen, Beliebtheit bei jedem Flug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells Cappadocia's legends: reviews glow, popularity on every flight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta las leyendas de Capadocia: reseñas brillantes y popularidad en cada vuelo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カッパドキアの伝説を語る：口コミが輝き、毎回人気アップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카파도키아의 전설을 들려줌: 리뷰가 빛나고 매 비행마다 인기 상승."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapadokya efsanelerini anlatır: yorumlar parlar, popülerlik."
          }
        }
      }
    },
