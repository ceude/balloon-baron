    "flight.abort.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ballon ist noch am Boden. Wenn du absagst, zahlst du den Touristen im Korb eine Entschädigung. Passagiere: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balloon hasn't left the ground yet. If you cancel, you pay compensation to the tourists in the basket. Passengers: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El globo aún no ha despegado. Si cancelas, pagas una compensación a los turistas de la cesta. Pasajeros: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気球はまだ地上にいる。中止するとバスケットの観光客に補償金を払う。乗客：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기구가 아직 이륙하지 않았습니다. 취소하면 바스켓의 관광객에게 보상금을 지급합니다. 승객: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balon henüz yerden kalkmadı. İptal edersen sepetteki turistlere tazminat ödersin. Yolcu: %@"
          }
        }
      }
    },
