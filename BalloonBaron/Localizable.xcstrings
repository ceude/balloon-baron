    "repChart.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel ein paar Tage, dann siehst du hier, wie sich deine Beliebtheit von Tag zu Tag ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a few days and you'll see here how your popularity changes from day to day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega unos días y aquí verás cómo cambia tu popularidad de un día a otro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数日プレイすると、ここで人気の日々の変化が見られる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "며칠 플레이하면 여기서 인기가 날마다 어떻게 변하는지 볼 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç gün oynadıktan sonra burada popülerliğinin günden güne nasıl değiştiğini göreceksin."
          }
        }
      }
    },
    "repChart.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beliebtheit steigt mit perfekten Landungen; Unfälle, weite Landungen, Absagen und Ballonwerbung senken sie. Hohe Beliebtheit bringt zusätzliche Touristen. Zusätzliche Touristen heute: etwa %1$@. Über %2$@ steigen die Erwartungen, und die Beliebtheit bröckelt jeden Tag ein wenig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Popularity rises with perfect landings; accidents, far landings, cancellations and balloon ads lower it. High popularity brings extra tourists. Extra tourists today: about %1$@. Above %2$@ expectations rise and popularity wears down a little every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La popularidad sube con aterrizajes perfectos; los accidentes, los aterrizajes lejanos, las cancelaciones y los anuncios en globos la bajan. Una popularidad alta trae turistas extra. Turistas extra hoy: unos %1$@. Por encima de %2$@ las expectativas suben y la popularidad se desgasta un poco cada día."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人気は完璧な着陸で上がり、事故・遠い着陸・キャンセル・気球広告で下がる。人気が高いと観光客が増える。今日の追加観光客：約%1$@。%2$@を超えると期待が高まり、人気は毎日少しずつ下がる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인기는 완벽한 착륙으로 오르고 사고, 먼 착륙, 취소, 열기구 광고로 떨어집니다. 인기가 높으면 관광객이 더 옵니다. 오늘 추가 관광객: 약 %1$@. %2$@ 이상에서는 기대치가 높아져 인기가 매일 조금씩 깎입니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popülerlik kusursuz inişlerle yükselir; kazalar, uzak inişler, iptaller ve balon reklamları düşürür. Yüksek popülerlik ekstra turist getirir. Bugünkü ekstra turist: yaklaşık %1$@. %2$@ üzerinde beklentiler yükselir, popülerlik her gün biraz aşınır."
          }
        }
      }
    },
    "repChart.hotels": {
      "extractionState": "manual",
