    "review.design.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben gebucht, nachdem wir den Ballon \"{d}\" gesehen hatten. Die Fotos sind legendär!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We booked after seeing the \"{d}\" balloon. The photos are legendary!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservamos después de ver el globo \"{d}\". ¡Las fotos son legendarias!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「{d}」柄の気球を見て予約した。写真が最高！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'{d}' 무늬 열기구를 보고 예약했어요. 사진이 전설이에요!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{d}\" desenli balonu görünce rezervasyon yaptık, fotoğraflar efsane oldu!"
          }
        }
      }
    },
    "review.design.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{d}\" war der schönste Ballon am Himmel. Darin zu sein war etwas Besonderes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{d}\" was the most beautiful balloon in the sky. Being in it felt special."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{d}\" era el globo más bonito del cielo. Ir dentro fue un privilegio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空でいちばん美しい気球は「{d}」だった。乗れて光栄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘에서 가장 아름다운 열기구는 '{d}'였어요. 타는 것만으로 특별했어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gökyüzündeki en güzel balon \"{d}\" idi, içinde olmak ayrıcalıktı."
          }
        }
      }
    },
    "review.design.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Design \"{d}\" ist so kreativ, die Kinder waren begeistert."
          }
        },
        "en": {
