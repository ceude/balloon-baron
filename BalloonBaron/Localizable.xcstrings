        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 지역이 자동 운영으로 벌었습니다. 지주회사 경비(%2$@)를 뺐습니다. 지주회사 금고: %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ otomatik modda kazandı, holding giderleri (%2$@) düşüldü. Holding kasası: %3$@."
          }
        }
      }
    },
