    "issue.accident.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ballon ist hart gelandet. Die Passagiere beschweren sich, die Lokalpresse steht vor der Tür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A balloon made a hard landing. Passengers are complaining and the local press is at the door."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un globo aterrizó bruscamente. Los pasajeros se quejan y la prensa local está en la puerta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気球がハードランディングした。乗客は苦情を言い、地元の記者が来ている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기구가 거칠게 착륙했습니다. 승객들은 항의하고 지역 언론이 찾아왔습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir balon sert iniş yaptı. Yolcular şikâyetçi, yerel basın kapıda."
          }
        }
      }
    },
    "issue.accident.hez": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An solchen Tagen ändert es alles, wenn der Chef vor Ort ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On days like this, the boss showing up changes everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En días así, que el jefe aparezca lo cambia todo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こういう日は、社長が顔を出すだけで全てが変わる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이런 날엔 사장이 직접 나타나는 게 모든 걸 바꾸지."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Böyle günlerde patronun orada olması her şeyi değiştirir."
          }
        }
      }
    },
