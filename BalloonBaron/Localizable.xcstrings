    "marketPage.guideBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du fliegst Hotel- und Reiseführer kostenlos, und sie empfehlen dich ihren Kunden. Sofort +0,2★ und 3 Tage lang Touristen, die die Führer schicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You fly hotel and tour guides for free and they recommend you to their clients. +0.2★ right away, and tourists sent by guides for 3 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas gratis a guías de hotel y de turismo y te recomiendan a sus clientes. +0,2★ al instante y turistas enviados por los guías durante 3 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホテルやツアーのガイドを無料で乗せると、客にあなたを勧めてくれる。すぐに+0.2★、3日間ガイドの紹介で観光客が来る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호텔·투어 가이드를 무료로 태우면 고객들에게 당신을 추천합니다. 즉시 +0.2★, 그리고 3일 동안 가이드가 보낸 관광객이 옵니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otel ve tur rehberlerini ücretsiz uçurursun, seni müşterilerine önerirler. Hemen +0,2★ ve 3 gün boyunca rehberlerin gönderdiği turistler."
          }
        }
      }
    },
    "marketPage.hotelBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt: %1$@. Vertrag: %2$@/Tag. Gäste: ~%3$@. Beliebtheit: +%4$@/Tag. Die Gäste zahlen Tickets bis %5$@. Kaufst du es, entfällt die Gebühr und Zimmereinnahmen kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs: %1$@. Deal: %2$@/day. Guests: ~%3$@. Popularity: +%4$@/day. Its guests accept tickets up to %5$@. Buy it and the fee ends, room income starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere: %1$@. Acuerdo: %2$@/día. Huéspedes: ~%3$@. Popularidad: +%4$@/día. Sus huéspedes aceptan billetes de hasta %5$@. Si lo compras, se acaba la cuota y llegan ingresos por habitaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要：%1$@。契約：%2$@/日。宿泊客：約%3$@。人気：+%4$@/日。宿泊客は%5$@までのチケットなら受け入れる。買収すれば手数料がなくなり、客室収入が入る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요: %1$@. 제휴: %2$@/일. 투숙객: 약 %3$@. 인기: +%4$@/일. 투숙객은 %5$@까지의 티켓을 받아들입니다. 매입하면 수수료가 없어지고 객실 수입이 생깁니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereken: %1$@. Anlaşma: %2$@/gün. Misafir: ~%3$@. Popülerlik: +%4$@/gün. Misafirleri en fazla %5$@ bilete razı. Satın alırsan ücret biter, oda geliri gelir."
          }
        }
      }
    },
