    "mission.desc.panorama": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steig für den Fotografen über 550 m und komm dann runter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Climb above 550 m for the photographer, then come down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube por encima de 550 m para el fotógrafo y luego baja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラマンのために550 m以上へ上昇し、その後降下。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진가를 위해 550 m 이상 올라갔다가 내려오세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafçı için 550 m üstüne çık, sonra in."
          }
        }
      }
    },
    "mission.desc.precision": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lande höchstens 40 m von der Bodencrew entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land within 40 m of the ground crew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterriza a menos de 40 m del equipo de tierra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地上クルーから40 m以内に着陸。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지상 요원 40 m 이내에 착륙하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yer ekibinin tam yanına, 40 m içine in."
          }
        }
      }
    },
    "mission.desc.proposal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib 8 Sekunden am Stück zwischen 250 und 350 m. Im Korb liegt ein Ring!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay between 250 and 350 m for 8 seconds without a break. There's a ring in the basket!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente entre 250 y 350 m durante 8 segundos seguidos. ¡Hay un anillo en la cesta!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度250〜350 mを8秒間キープ。バスケットには指輪が！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "250~350 m 사이에서 8초간 머무르세요. 바스켓에 반지가 있어요!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "250–350 m arasında kesintisiz 8 saniye kal. Sepette yüzük var!"
          }
        }
      }
    },
