    "report.adBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute hat die Werbung auf deinen Ballonen deine Beliebtheit um %@ gesenkt."
