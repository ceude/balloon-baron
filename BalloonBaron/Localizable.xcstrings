    "event.wedding.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Hochzeitsgesellschaft aus dem %1$@ möchte %2$@ ganz, 40 %% mehr pro Kopf. %3$@ im Voraus; der Ballon nimmt heute keine anderen Fahrgäste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wedding party staying at %1$@ wants all of %2$@, paying 40%% more per head. %3$@ up front; the balloon takes no other passengers today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grupo de boda alojado en %1$@ quiere %2$@ entero y paga un 40 %% más por persona. %3$@ por adelantado; el globo no lleva más pasajeros hoy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に泊まる結婚式の一行が%2$@を丸ごと希望、1人あたり40%%増し。前金%3$@。今日この気球は他の客を乗せない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 묵는 결혼식 일행이 %2$@를 통째로 원하며 1인당 40%% 더 냅니다. 선불 %3$@, 이 열기구는 오늘 다른 승객을 받지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ otelinde kalan bir düğün grubu %2$@ balonunu toptan istiyor, kişi başı %%40 fazla. Peşin %3$@, balon bugün başka yolcu almaz."
          }
        }
      }
    },
    "event.wedding.no": {
