    "review.design.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{d}\" war der schönste Ballon am Himmel. Darin zu sein war etwas Besonderes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{d}\" was the most beautiful balloon in the sky. Being in it felt special."
