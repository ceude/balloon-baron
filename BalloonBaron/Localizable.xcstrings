    "event.accident.light": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) hatte eine harte Landung und bleibt %3$@ Tage am Boden. Reparatur %4$@, Entschädigung %5$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) had a hard landing and will be grounded for %3$@ days. Repairs %4$@, compensation %5$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) tuvo un aterrizaje brusco y quedará en tierra %3$@ días. Reparación %4$@, indemnización %5$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）がハードランディング。%3$@日間地上待機。修理費%4$@、補償%5$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) 거친 착륙으로 %3$@일간 운항 불가. 수리비 %4$@, 보상금 %5$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) sert iniş yaptı ve %3$@ gün yerde kalacak. Onarım %4$@, tazminat %5$@."
          }
        }
      }
    },
    "event.accident.severe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) hatte einen schweren Unfall und bleibt %3$@ Tage am Boden. Reparatur %4$@, Entschädigung %5$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) had a serious accident and will be grounded for %3$@ days. Repairs %4$@, compensation %5$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) sufrió un accidente grave y quedará en tierra %3$@ días. Reparación %4$@, indemnización %5$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）が重大事故。%3$@日間地上待機。修理費%4$@、補償%5$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) 중대 사고로 %3$@일간 운항 불가. 수리비 %4$@, 보상금 %5$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) ağır kaza yaptı ve %3$@ gün yerde kalacak. Onarım %4$@, tazminat %5$@."
          }
        }
      }
    },
    "event.antitrustFine": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wettbewerbsbehörde verhängte %2$@ Strafe, weil du %1$@ %% des Marktes hältst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Competition Authority fined you %2$@ for holding %1$@%% of the market."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Autoridad de la Competencia te multó con %2$@ por controlar el %1$@ %% del mercado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "市場の%1$@%%を握っているとして、競争当局が%2$@の罰金を科した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시장의 %1$@%%를 차지해 경쟁 당국이 %2$@의 벌금을 부과했습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekabet Kurumu pazarın %%%1$@ kısmını elinde tuttuğun için %2$@ tekel cezası kesti."
          }
        }
      }
    },
    "event.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Flug mit %1$@ abgesagt. %2$@ Passagiere bekamen ihr Geld zurück und je %3$@ Entschädigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cancelled the %1$@ flight. %2$@ passengers got their money back plus %3$@ each in compensation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelaste el vuelo del %1$@. %2$@ pasajeros recuperaron su dinero y recibieron %3$@ cada uno de indemnización."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のフライトを中止した。乗客%2$@人に払い戻しと、一人%3$@の補償を支払った。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 비행을 취소했습니다. 승객 %2$@명에게 환불하고 1인당 %3$@의 보상금을 지급했습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uçuşunu iptal ettin. %2$@ yolcunun bilet parası iade edildi ve kişi başı %3$@ tazminat ödendi."
          }
        }
      }
    },
    "event.envelopeWorn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hülle von %@ ist verschlissen. Ohne Erneuerung kein Flug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The envelope of %@ is worn out. It can't fly until renewed."
          }
