    "psheet.crowded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touristen heute: %1$@. Plätze am Himmel, Konkurrenz eingerechnet: %2$@. Zu viele Plätze, harter Wettbewerb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourists today: %1$@. Seats in the sky, rivals included: %2$@. Too many seats, tough competition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Turistas hoy: %1$@. Plazas en el cielo, rivales incluidos: %2$@. Sobran plazas, la competencia es dura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の観光客：%1$@。ライバル込みの空の座席：%2$@。座席が多すぎて競争は厳しい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 관광객: %1$@. 경쟁사 포함 하늘의 좌석: %2$@. 좌석이 많아 경쟁이 치열합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün turist: %1$@. Rakiplerle birlikte gökyüzünde koltuk: %2$@. Koltuk fazla, rekabet sert."
          }
        }
      }
    },
    "psheet.docNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "4 Plätze im Flaggschiff hat das Doku-Team."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4 seats in the flagship are with the documentary crew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "4 asientos del globo insignia son del equipo del documental."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旗艦の4席はドキュメンタリー班用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기함의 4석은 다큐멘터리 팀 몫입니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amiralde 4 koltuk belgesel ekibinde."
          }
        }
      }
    },
    "psheet.easy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touristen heute: %1$@. Plätze am Himmel, Konkurrenz eingerechnet: %2$@. Mehr Touristen als Plätze, die Ballone füllen sich leicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourists today: %1$@. Seats in the sky, rivals included: %2$@. More tourists than seats, balloons fill easily."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Turistas hoy: %1$@. Plazas en el cielo, rivales incluidos: %2$@. Hay más turistas que plazas, los globos se llenan fácil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の観光客：%1$@。ライバル込みの空の座席：%2$@。観光客が座席より多く、気球はすぐ埋まる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 관광객: %1$@. 경쟁사 포함 하늘의 좌석: %2$@. 관광객이 좌석보다 많아 쉽게 찹니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün turist: %1$@. Rakiplerle birlikte gökyüzünde koltuk: %2$@. Turist fazla, balonlar kolay dolar."
          }
        }
      }
    },
