          }
        }
      }
    },
    "review.red.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wind heulte, kein anderer Ballon war oben. Warum wir?!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wind was howling and no other balloon took off. Why did we?!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viento aullaba y ningún otro globo despegó. ¡¿Por qué nosotros sí?!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "風がうなり、ほかの気球は一機も飛んでいなかった。なぜ私たちは飛んだの？！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바람이 윙윙거리고 다른 열기구는 하나도 안 떴는데, 우린 왜 날았죠?!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rüzgâr uğulduyordu, başka hiçbir balon kalkmamıştı. Biz neden uçtuk?!"
          }
        }
      }
    },
    "review.red.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Firma, die Regeln ignoriert. Die Flagge war rot, und sie sind trotzdem gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A company that ignores the rules. The flag was red and they still took off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una empresa que ignora las normas. La bandera era roja y aun así despegaron."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールを守らない会社。旗は赤だったのに飛ばした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙을 무시하는 회사. 깃발이 빨간데도 띄웠어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurallara uymayan bir şirket. Bayrak kırmızıydı, yine de kaldırdılar."
          }
        }
      }
    },
    "review.rival.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigentlich wollten wir mit {r} fliegen, zum Glück haben wir umentschieden. {c} war großartig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We were going to fly with {r}; glad we changed our minds. {c} was amazing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Íbamos a volar con {r}; menos mal que cambiamos de idea. {c} fue increíble."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初は{r}で飛ぶつもりだったが、変えて正解。{c}は最高だった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 {r}로 가려다 마음을 바꿨는데 잘했어요. {c} 최고였어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce {r} ile uçacaktık, iyi ki fikrimizi değiştirmişiz. {c} harikaydı."
          }
        }
      }
    },
    "review.rival.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{r} war ausgebucht, also flogen wir mit {c}. Kein bisschen bereut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{r} was full, so we flew with {c}. No regrets at all."
          }
        },
        "es": {
