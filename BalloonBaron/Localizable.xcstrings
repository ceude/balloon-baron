    "ceremony.baronHint.abq": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel zweier Kontinente gehört dir. Die nächsten Regionen erscheinen bald auf der Karte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The skies of two continents are yours. The next regions will appear on the map very soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo de dos continentes es tuyo. Las próximas regiones aparecerán pronto en el mapa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つの大陸の空は君のものだ。次の地域はまもなく地図に現れる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 대륙의 하늘이 당신의 것입니다. 다음 지역들이 곧 지도에 나타납니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki kıtanın göğü senin. Sıradaki bölgeler çok yakında haritada belirecek."
          }
        }
      }
    },
    "ceremony.baronHint.cap": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Firma kann jetzt in die Welt hinaus. Deine erste neue Region wartet auf der Weltkarte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your company can now go global. Your first new region awaits on the world map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu empresa ya puede salir al mundo. Tu primera región nueva te espera en el mapa del mundo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これで会社は世界へ進出できる。最初の新しい地域が世界地図で待っている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 회사가 세계로 나아갈 수 있습니다. 첫 새 지역이 세계 지도에서 기다립니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şirketin artık dünyaya açılabilir. Dünya haritasında ilk yeni bölgen seni bekliyor."
          }
        }
      }
    },
    "ceremony.baronLead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag %1$@. Zwei von drei Ballonen am Himmel über %2$@ tragen die Farben von %3$@. Meister Hezarfen hat Tränen in den Augen: „Nicht einmal an dem Tag, als ich von Galata nach Üsküdar flog, war ich so stolz, Lehrling.“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day %1$@. Two of every three balloons in the sky over %2$@ fly the colors of %3$@. Master Hezarfen's eyes are wet: “Not even the day I flew from Galata to Üsküdar was I this proud, kid.”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Día %1$@. Dos de cada tres globos en el cielo de %2$@ llevan los colores de %3$@. Al maestro Hezarfen se le humedecen los ojos: «Ni el día que volé de Gálata a Üsküdar estuve tan orgulloso, aprendiz»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@日目。%2$@の空を飛ぶ気球の3機に2機が%3$@の色だ。ヘザルフェン師匠の目が潤む。「ガラタからユスキュダルへ飛んだ日でさえ、これほど誇らしくはなかったぞ」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@일차. %2$@ 하늘의 열기구 세 대 중 두 대가 %3$@의 색을 달고 있습니다. 헤자르펜 장인의 눈시울이 붉어집니다. “갈라타에서 위스퀴다르로 날던 날도 이렇게 자랑스럽진 않았다네.”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün %1$@. %2$@ göğündeki her üç balondan ikisi %3$@ renklerinde. Hezarfen Usta'nın gözleri dolu: “Galata'dan Üsküdar'a uçtuğum gün bile bu kadar gururlanmamıştım, evlat.”"
          }
        }
      }
    },
