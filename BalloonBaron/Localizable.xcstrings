    "home.alert.expired": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lizenz ist abgelaufen, deine anderen Ballone bleiben am Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your license has expired; your other balloons are grounded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu licencia ha caducado; tus otros globos están en tierra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "免許が切れ、ほかの気球は飛べない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
