    "bazaar.shapes.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt als fertiges Design und geht direkt auf dein Flaggschiff. Verblasst nie; zusätzliche Beliebtheit bei jedem Flug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comes as a ready design and goes straight onto your flagship. Never fades; extra popularity on every flight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega como diseño listo y va directo a tu globo insignia. Nunca pierde frescura; popularidad extra en cada vuelo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完成デザインとして届き、すぐ旗艦に着せられる。色あせず、毎回の飛行で人気アップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성 디자인으로 와서 바로 기함에 입혀집니다. 바래지 않고 매 비행마다 추가 인기."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır tasarımıyla gelir, amiral balonuna hemen giydirilir. Hiç eskimez, her uçuşta ekstra popülerlik."
          }
        }
      }
    },
