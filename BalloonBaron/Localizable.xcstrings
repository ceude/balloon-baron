    "event.moment.greet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr habt am Himmel einem Nachbarballon zugewinkt; die Fahrgäste waren begeistert. Trinkgeld %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You waved to a neighbouring balloon in the sky; the passengers loved it. Tips %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saludasteis a un globo vecino en el cielo; a los pasajeros les encantó. Propinas %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空で隣の気球とあいさつし、乗客は手を振った。チップ %@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘에서 이웃 열기구와 인사했고 승객들이 손을 흔들었습니다. 팁 %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gökyüzünde komşu balonla selamlaştınız, yolcular el salladı. Bahşiş %@."
          }
        }
      }
    },
    "event.moment.photo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sonnenaufgangsfoto der Fahrgäste ging durchs ganze Tal. Trinkgeld %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passengers' sunrise photo went round the whole valley. Tips %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto del amanecer de los pasajeros recorrió todo el valle. Propinas %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "乗客の日の出写真が谷じゅうで話題に。チップ %@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승객의 일출 사진이 계곡 전체에 퍼졌습니다. 팁 %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolcuların gün doğumu fotoğrafı bütün vadide paylaşıldı. Bahşiş %@."
          }
        }
      }
    },
    "event.moment.thermal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast eine Thermik erwischt; die Fahrgäste liebten das Gleiten. Trinkgeld %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You caught a thermal on the flight; the passengers loved gliding. Tips %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrapaste una térmica en el vuelo; a los pasajeros les encantó planear. Propinas %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飛行中に上昇気流をつかみ、乗客は滑空に大喜び。チップ %@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비행 중 상승기류를 탔고 승객들이 활공을 즐겼습니다. 팁 %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçuşta bir termik yakaladın, yolcular süzülmeye bayıldı. Bahşiş %@."
          }
        }
      }
    },
    "event.newEntrant": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Konkurrenz: %1$@ fliegt jetzt in %2$@!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New rival: %1$@ has started flying in %2$@!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevo rival: ¡%1$@ empieza a volar en %2$@!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新たなライバル：%1$@が%2$@で飛行を開始！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 경쟁자: %1$@ %2$@에서 비행을 시작했습니다!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni rakip: %1$@ %2$@ bölgesinde uçmaya başladı!"
          }
        }
      }
    },
    "event.perfectLanding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: perfekte Landung. Die Passagiere gaben %2$@ Trinkgeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: perfect landing. Passengers left %2$@ in tips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: aterrizaje perfecto. Los pasajeros dejaron %2$@ de propina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：完璧な着陸。乗客から%2$@のチップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 완벽한 착륙. 승객들이 %2$@의 팁을 남겼습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: kusursuz iniş. Yolcular %2$@ bahşiş bıraktı."
          }
        }
      }
    },
    "event.pilotPromoted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist jetzt Pilot der Stufe %2$@! Weniger Unfallrisiko, Gehalt jetzt %3$@/Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is now a %2$@ pilot! Accident risk is down, wage is now %3$@/day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡%1$@ ya es piloto de nivel %2$@! Menos riesgo de accidente; sueldo ahora %3$@/día."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が%2$@パイロットに昇格！事故リスクが下がり、日給は%3$@に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 조종사가 %2$@ 등급이 되었습니다! 사고 위험이 줄고 일급은 %3$@가 되었습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ artık %2$@ pilot! Kaza riski düştü, maaşı %3$@/gün oldu."
          }
        }
      }
    },
    "event.poachAttempt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat deinem Piloten %2$@ einen Job angeboten!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ offered your pilot %2$@ a job!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡%1$@ ofreció trabajo a tu piloto %2$@!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@があなたのパイロット%2$@を引き抜こうとしている！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 측이 내 조종사 %2$@에게 일자리를 제안했습니다!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, pilotun %2$@ için iş teklifi yaptı!"
          }
        }
      }
    },
    "event.press.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Reporter der %@ steht vor deinem Büro und möchte ein Interview über Ballontourismus. Läuft es gut, spricht sich dein Name herum; wenn nicht, bist du die Schlagzeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reporter from the %@ is outside your office and wants an interview about balloon tourism. If it goes well your name gets around; if not, you're the headline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un periodista del %@ está frente a tu oficina y quiere una entrevista sobre el turismo en globo. Si sale bien, tu nombre se conocerá; si no, serás el titular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の記者が事務所の前にいて、気球観光について取材したいという。うまくいけば名が知れ、失敗すれば見出しになる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 기자가 사무실 앞에서 열기구 관광에 대한 인터뷰를 원합니다. 잘되면 이름이 알려지고, 아니면 헤드라인이 됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gazetesinden bir muhabir ofisinin önünde. Balon turizmi hakkında röportaj istiyor. İyi geçerse adın duyulur, kötü geçerse manşet olursun."
          }
        }
      }
    },
