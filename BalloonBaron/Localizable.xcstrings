          "stringUnit": {
            "state": "translated",
            "value": "A lasting decoration in town; each brings 1% more tourists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adorno permanente en el pueblo; cada uno atrae un 1 % más de turistas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "町に残る飾り。一つごとに観光客が1%増える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마을에 남는 장식. 하나당 관광객이 1% 늘어납니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasabada kalıcı süs, her biri talebi %1 artırır."
          }
        }
      }
    },
