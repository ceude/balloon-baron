    "marketPage.style.risky": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Billig und unversichert. Startet womöglich sogar bei roter Flagge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheap and uninsured. May take off even on a red flag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barata y sin seguro. Puede despegar incluso con bandera roja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安くて無保険。赤い旗の日でも飛ぶことがある。"
