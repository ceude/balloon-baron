    "office.tyo.perk": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Designs kostenlos, Kreativität +10, Designs bleiben 60 Tage frisch. Einstieg in Asien zum halben Preis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free design production, creativity +10, designs stay fresh for 60 days. Half-price entry to Asia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseños gratis, creatividad +10, los diseños siguen frescos 60 días. Entrada a Asia a mitad de precio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザイン制作が無料、創造性+10、デザインが60日間新鮮。アジア進出が半額。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디자인 제작 무료, 창의성 +10, 디자인 신선도 60일 유지. 아시아 진출 반값."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasarım üretimi bedava, yaratıcılık +10, tasarımlar 60 gün taze kalır. Asya'ya giriş yarı fiyatına."
          }
        }
      }
    },
    "outcome.doc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kameras sind bereit, Lehrling. Flieg heute schön, die ganze Welt schaut zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cameras are ready, kid. Fly well today; the whole world will be watching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cámaras están listas, aprendiz. Vuela bien hoy; el mundo entero estará mirando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの準備はできた、弟子よ。今日は見事に飛べ。世界中が見ているぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 준비됐네, 제자여. 오늘 멋지게 날게. 온 세상이 지켜볼 걸세."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameralar hazır evlat. Bugün güzel uç, bütün dünya izleyecek."
          }
        }
      }
    },
    "outcome.fuelStocked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Flaschen sind im Hangar. Kluger Zug, Lehrling."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tanks are in the hangar. Smart move, kid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bombonas están en el hangar. Bien pensado, aprendiz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボンベは格納庫だ。賢いぞ、弟子よ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가스통은 격납고에 있네. 현명했네, 제자여."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüpler hangarda, akıllıca evlat."
          }
        }
      }
    },
    "outcome.pressBad": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hm, bei der Preisfrage bist du ins Stocken geraten. Die Zeitung wird morgen nicht nett schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmm, you stumbled over the price question. Tomorrow's paper won't be kind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mmm, titubeaste con la pregunta del precio. El periódico de mañana no será amable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うーむ、料金の質問でしどろもどろだったな。明日の新聞は手厳しいだろう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음, 가격 질문에서 좀 버벅였군. 내일 신문은 곱게 쓰지 않을 걸세."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmm, fiyat sorusunda biraz bocaladın. Yarın gazete pek hoş yazmayacak."
          }
        }
      }
    },
    "outcome.pressGood": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Interview lief großartig, Lehrling; morgen steht es in der Zeitung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interview went brilliantly, kid; it's in tomorrow's paper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrevista salió genial, aprendiz; mañana sale en el periódico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取材は大成功だ、弟子よ。明日の新聞に載るぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터뷰가 아주 잘됐네, 제자여. 내일 신문에 실린다네."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Röportaj harika geçti evlat, yarın gazetede."
          }
        }
      }
    },
    "outcome.strikeEndured": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Ballone bleiben heute am Boden, und die Piloten schwenken Plakate. Morgen kommen sie zurück, aber die Touristen werden darüber reden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your balloons are on the ground today and the pilots are waving placards. They'll be back tomorrow, but the tourists will talk about it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy tus globos están en tierra y los pilotos agitan pancartas. Mañana volverán, pero los turistas hablarán de ello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は気球が地上に留まり、パイロットはプラカードを振っている。明日には戻るが、観光客の噂にはなるだろう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 열기구는 땅에 있고 조종사들은 피켓을 흔들고 있네. 내일은 돌아오겠지만 관광객들 사이에 소문이 날 걸세."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün balonların yerde, pilotlar pankart sallıyor. Yarın işe dönecekler ama turistler bunu konuşacak."
          }
        }
      }
    },
    "outcome.strikeRaised": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Piloten sind zufrieden, Lehrling, heute sind alle in ihren Körben. Aber die Lohnliste ist gewachsen, also pass deine Preise an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pilots are happy, kid; everyone is in their basket today. But the payroll has grown, so set your prices to match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pilotos están contentos, aprendiz; hoy todos están en su cesta. Pero la nómina ha crecido, así que ajusta tus precios."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パイロットたちは満足だ、弟子よ。今日は皆バスケットにいる。だが人件費が膨らんだから、料金を見直すのだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종사들이 만족했네, 제자여. 오늘은 모두 바구니에 있다네. 하지만 인건비가 늘었으니 가격을 맞춰 조정하게."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilotlar mutlu evlat, bugün herkes sepetinde. Ama maaş bordrosu kabardı, fiyatları ona göre ayarla."
          }
        }
      }
    },
    "outcome.vip": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gute Arbeit, Lehrling. Reiche Leute reden, und man hört ihnen zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good work, kid. The rich talk, and what they say gets heard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen trabajo, aprendiz. Los ricos hablan, y lo que dicen se oye."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よくやった、弟子よ。金持ちは噂をし、その噂は広まるものだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘했네, 제자여. 부자들은 말이 많고, 그 말은 퍼지기 마련이라네."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güzel iş evlat. Zenginler konuşur, konuştukları da duyulur."
          }
        }
      }
    },
    "outcome.wedding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Braut soll im Korb geweint haben, vor Glück. Die Fotos werden im ganzen Tal herumgehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They say the bride cried in the basket, from happiness. The photos will go round the whole valley."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicen que la novia lloró en la cesta, de felicidad. Las fotos recorrerán todo el valle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "花嫁はバスケットで泣いたそうだ、幸せで。写真は谷じゅうに広まるだろう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신부가 바구니에서 울었다더군, 행복해서. 사진이 계곡 전체에 퍼질 걸세."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelin sepette ağlamış diyorlar, mutluluktan. Fotoğraflar bütün vadide dolaşacak."
          }
        }
      }
    },
