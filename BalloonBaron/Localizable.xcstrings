    "bazaar.patterns.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt als fertiges Design und geht direkt auf dein Flaggschiff. Hohe Kreativität, verblasst nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comes as a ready design and goes straight onto your flagship. High creativity, never fades."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega como diseño listo y va directo a tu globo insignia. Mucha creatividad y nunca pierde frescura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完成デザインとして届き、すぐ旗艦に着せられる。創造性が高く、色あせない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성 디자인으로 와서 바로 기함에 입혀집니다. 창의성이 높고 바래지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır tasarımıyla gelir, amiral balonuna hemen giydirilir. Yüksek yaratıcılık, hiç eskimez."
          }
        }
      }
    },
    "bazaar.shapes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
