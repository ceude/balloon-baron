    "map.openSub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stadt des größten Ballonfestivals der Welt. Die berühmten „Box“-Winde bringen dich zurück zum Startplatz. Eintritt %@ aus der Holding (FAA-Lizenz und Büro); in der Region fängst du bei null an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City of the world's biggest balloon festival. The famous “box” winds bring you back to where you took off. Entry fee %@ from the holding (FAA license and office); you start from scratch in the region."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ciudad del mayor festival de globos del mundo. Los famosos vientos de «caja» te devuelven a donde despegaste. Entrada de %@ del holding (licencia FAA y oficina); empiezas desde cero en la región."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界最大の気球フェスティバルの街。名高い「ボックス」風が離陸地点へ連れ戻してくれる。参入費%@はホールディングスから（FAAライセンスと事務所）。この地域ではゼロから始まる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세계 최대 열기구 축제의 도시. 유명한 ‘박스’ 바람이 이륙한 곳으로 되돌려 줍니다. 진입 비용 %@은(는) 지주회사에서 지급(FAA 면허와 사무실). 이 지역에서는 처음부터 시작합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünyanın en büyük balon festivalinin şehri. Meşhur “kutu” rüzgârları seni kalktığın yere geri getirir. Giriş bedeli %@ holding kasasından (FAA lisansı ve ofis); bölgede sıfırdan başlarsın."
          }
        }
      }
    },
