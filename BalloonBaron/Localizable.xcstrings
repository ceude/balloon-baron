            "value": "El banco embargó %1$@ por tu deuda y lo vendió por %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "借金のため銀行が%1$@を差し押さえ、%2$@で売却した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행이 빚 때문에 %1$@ 열기구를 압류해 %2$@에 팔았습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banka borcun için %1$@ balonuna el koydu ve %2$@ karşılığında sattı."
          }
        }
      }
    },
    "event.strike.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Piloten warten mit Plakaten vor deinem Büro. Sie wollen 15 %% mehr Lohn. Du zahlst derzeit %@ pro Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pilots are waiting outside your office with placards. They want a 15%% raise. You now pay %@ a day in wages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus pilotos esperan frente a tu oficina con pancartas. Quieren un aumento del 15 %%. Ahora pagas %@ al día en sueldos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パイロットたちがプラカードを手に事務所の前で待っている。15%%の賃上げを求めている。今の人件費は1日%@だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종사들이 사무실 앞에서 피켓을 들고 기다립니다. 15%% 임금 인상을 요구합니다. 지금 하루 인건비는 %@입니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilotların ofisinin önünde pankartlarla bekliyor. Maaşlarına %%15 zam istiyorlar. Şu an günde toplam %@ ödüyorsun."
          }
        }
      }
    },
    "event.strike.no": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Tag durchhalten: heute fliegst nur du"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold out a day: only you fly today"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguanta un día: hoy solo vuelas tú"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日耐える：今日は自分だけ飛ぶ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 버티기: 오늘은 당신만 비행"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir gün dayan: bugün sadece sen uçarsın"
          }
        }
      }
    },
    "event.strike.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Piloten streiken!"
          }
        },
        "en": {
