    "review.design.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben gebucht, nachdem wir den Ballon \"{d}\" gesehen hatten. Die Fotos sind legendär!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We booked after seeing the \"{d}\" balloon. The photos are legendary!"
          }
