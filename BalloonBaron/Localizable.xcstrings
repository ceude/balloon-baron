    "merge.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ihrer dicken Kasse kann die neue Firma Preise drücken, deine Hotels abwerben und schnell wachsen. Schütze deine Beliebtheit und sichere deine Hotelverträge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With its big cash pile the new company can undercut your prices, go after your hotels and grow fast. Guard your popularity and lock in your hotel deals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con su gran caja, la nueva empresa puede bajar precios, ir a por tus hoteles y crecer rápido. Cuida tu popularidad y asegura tus acuerdos con hoteles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新会社は豊富な資金で値下げを仕掛け、君のホテルを奪おうとし、急成長するだろう。人気を守り、ホテル契約を固めろ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 회사는 막대한 자금으로 가격을 낮추고 호텔을 빼앗으려 하며 빠르게 성장할 겁니다. 인기를 지키고 호텔 계약을 다져 두세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni şirket büyük kasasıyla fiyat kırabilir, otellerini kapmaya çalışabilir ve hızla büyüyecek. Popülerliğini koru, otel anlaşmalarını sağlamlaştır."
          }
        }
      }
    },
