            "state": "translated",
            "value": "Gründe deine eigene Pilotenschule"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found your own pilot school"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
