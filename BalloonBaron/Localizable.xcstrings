    "issue.accident.a.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wechselst in die Region; die Beliebtheit sinkt etwas, aber die Geschichte ist erledigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You move to the region; popularity dips a little but the story is over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te trasladas a la región; la popularidad baja un poco, pero la historia se cierra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その地域へ移動する。人気は少し下がるが、騒ぎは収まる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 지역으로 이동합니다. 인기는 조금 떨어지지만 이야기는 끝납니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölgeye geçersin, popülerlik biraz düşer ama hikâye kapanır."
          }
        }
      }
    },
    "issue.accident.b": {
      "extractionState": "manual",
      "localizations": {
