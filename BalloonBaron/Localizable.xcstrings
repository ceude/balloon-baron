    "crew.idle.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden jeden Tag bezahlt, fliegen aber nicht. Kauf einen Ballon oder entlasse sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They get paid every day but don't fly. Buy a balloon or let them go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobran cada día pero no vuelan. Compra un globo o despídelos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日給料をもらっているのに飛んでいない。気球を買うか解雇しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 급여를 받지만 비행하지 않습니다. 열기구를 사거나 해고하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün maaş alıyorlar ama uçmuyorlar. Yeni balon al ya da kov."
          }
        }
      }
    },
    "crew.idle.callout": {
