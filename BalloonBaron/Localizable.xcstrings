    "holding.officesAll": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Büros auf vier Kontinenten. Die Holdingkosten betragen %1$@ statt %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have offices on four continents. Holding expenses are %1$@ instead of %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes oficinas en cuatro continentes. Los gastos del holding son del %1$@ en vez del %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4つの大陸にオフィスがある。ホールディングス経費は%2$@ではなく%1$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 대륙에 사무소가 있습니다. 지주회사 비용은 %2$@ 대신 %1$@입니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört kıtada ofisin var. Holding giderlerin %2$@ yerine %1$@."
          }
        }
      }
    },
    "holding.officesHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eröffne Büros in den großen Städten der Welt; jedes hat einen eigenen Vorteil. Mit allen vier sinken die Holdingkosten von %1$@ auf %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open offices in the world's great cities; each one has its own perk. Open all four and holding expenses drop from %1$@ to %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre oficinas en las grandes ciudades del mundo; cada una tiene su ventaja. Con las cuatro, los gastos del holding bajan del %1$@ al %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界の大都市にオフィスを開こう。それぞれに特典がある。4つすべて開けばホールディングス経費は%1$@から%2$@に下がる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세계 대도시에 사무소를 여세요. 사무소마다 혜택이 있습니다. 네 곳을 모두 열면 지주회사 비용이 %1$@에서 %2$@(으)로 줄어듭니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünyanın büyük şehirlerinde ofis aç; her ofisin kendi avantajı var. Dördünü birden açarsan holding giderleri %1$@ yerine %2$@ olur."
          }
        }
      }
    },
