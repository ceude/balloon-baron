          }
        }
      }
    },
    "event.farLanding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Du bist %2$@ m vom Ziel gelandet, die Bodencrew hat dich spät gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: you landed %2$@ m from the target and the ground crew was late to find you."
