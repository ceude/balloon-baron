          }
        }
      }
    },
    "event.seized": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bank hat wegen deiner Schulden %1$@ gepfändet und für %2$@ verkauft."
          }
        },
        "en": {
