        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission complete: %1$@. The customer paid a %2$@ reward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Misión cumplida: %1$@. El cliente pagó una recompensa de %2$@."
