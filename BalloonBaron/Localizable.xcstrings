    "menu.saved": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Spiel ist auf diesem Gerät gespeichert: Tag %1$@, Kasse %2$@. Es wird jeden Morgen und bei jeder Änderung automatisch gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your game is saved on this device: day %1$@, cash %2$@. It saves automatically every morning and with every change you make."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu partida está guardada en este dispositivo: día %1$@, caja %2$@. Se guarda sola cada mañana y con cada cambio que hagas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームはこの端末に保存されています: %1$@日目、資金%2$@。毎朝と変更のたびに自動保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 이 기기에 저장되었습니다: %1$@일차, 금고 %2$@. 매일 아침과 변경할 때마다 자동 저장됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunun bu cihaza kaydedildi: gün %1$@, kasa %2$@. Her sabah ve yaptığın her değişiklikte otomatik kaydedilir."
          }
        }
      }
    },
