    "rescue.price.sub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterbiete den billigsten Konkurrenten und fülle die Plätze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go below your cheapest rival and fill the seats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte por debajo del rival más barato y llena los asientos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最安のライバルより安くして席を埋める。"
