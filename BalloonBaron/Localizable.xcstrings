    "setup.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel über Kappadokien wartet. Wie sollen dich die Touristen nennen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cappadocia's sky is waiting. What will tourists call you?"
