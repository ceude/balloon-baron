    "deal.bankrupt.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Firma hat geschlossen. Ihre Flotte steht zum Verkauf: Ballons: %1$@, Preis: %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The company closed. Its fleet is for sale: balloons: %1$@, price: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La empresa cerró. Su flota está en venta: globos: %1$@, precio: %2$@."
          }
        },
        "ja": {
          "stringUnit": {
