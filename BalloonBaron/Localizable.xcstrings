    "repChart.hotelsBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotels empfehlen dich ihren Gästen und bringen jeden Tag Beliebtheit und Touristen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotels recommend you to their guests, bringing popularity and tourists every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hoteles te recomiendan a sus huéspedes y te traen popularidad y turistas cada día."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホテルが宿泊客に君を勧め、毎日人気と観光客をもたらす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호텔이 투숙객에게 당신을 추천해 매일 인기와 관광객을 가져다줍니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oteller misafirlerine seni önerir, her gün popülerlik ve turist getirir."
          }
        }
      }
    },
