    "event.licenseExpiring": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pilotenlizenz läuft heute ab. Morgen darfst du das Flaggschiff nicht selbst fliegen; erneuere sie im Crew-Tab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pilot license expires today. Tomorrow you can't fly the flagship yourself; renew it in the Crew tab."
          }
