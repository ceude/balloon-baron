    "home.alert.red.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du startest: 35 %% Risiko für %@ Strafe, und die Versicherung gilt nicht."
          }
        },
        "en": {
