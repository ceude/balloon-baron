        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot lisansın bugün sona eriyor. Yarın amiral balonunu kendin uçuramazsın; Ekip sekmesinden yenileyebilirsin."
          }
        }
      }
    },
