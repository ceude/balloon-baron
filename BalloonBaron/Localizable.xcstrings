    "red.insurance": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Versicherung zahlt heute weder Schäden noch Entschädigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insurance pays for no damage or compensation today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy el seguro no cubre ningún daño ni compensación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は保険が損害も補償金も一切払わない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 보험이 어떤 손해나 보상금도 지급하지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigorta bugün hiçbir hasarı ve tazminatı ödemez."
          }
        }
      }
    },
    "red.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist der Wind viel zu stark, Fliegen ist verboten. Wenn du trotzdem startest (Ballone: %@):"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wind is far too strong today and flying is banned. If you take your balloons up anyway (balloons: %@):"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy el viento es demasiado fuerte y está prohibido volar. Si despegas igualmente (globos: %@):"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は風が強すぎて飛行禁止。それでも飛ばすなら（気球：%@）："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 바람이 너무 강해 비행이 금지되었습니다. 그래도 띄운다면 (열기구: %@):"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün rüzgâr çok sert ve uçuş yasak. Balonları yine de kaldırırsan (balon: %@):"
          }
        }
      }
    },
    "red.reviews": {
