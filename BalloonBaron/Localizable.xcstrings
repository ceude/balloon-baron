    "cover.hullOnly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Versicherung zahlte die Reparatur, die Entschädigung kam aus deiner Kasse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insurance paid the repairs; compensation came out of your cash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguro pagó la reparación; la indemnización salió de tu caja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修理は保険、補償は自腹。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수리는 보험, 보상금은 금고에서 나갔습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigorta onarımı ödedi, tazminat kasadan çıktı."
          }
        }
      }
    },
