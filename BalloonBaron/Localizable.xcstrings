    "crew.licenseLapsed.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fliegst du heute selbst das Flaggschiff, wird deine Lizenz kostenlos erneuert. Willst du nicht fliegen, kannst du %@ zahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fly the flagship yourself today and your license renews for free. If you'd rather not fly, you can pay %@ to renew it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hoy pilotas tú el globo insignia, tu licencia se renueva gratis. Si prefieres no volar, puedes pagar %@ para renovarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日旗艦を自分で飛ばせば免許は無料で更新される。飛びたくなければ%@を払って更新できる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 기함을 직접 조종하면 면허가 무료로 갱신됩니다. 비행하기 싫다면 %@를 내고 갱신할 수 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün amiral balonunu kendin uçurursan lisansın ücretsiz yenilenir. Uçmak istemiyorsan %@ ödeyip yenileyebilirsin."
          }
        }
      }
    },
    "crew.licenseOk": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pilotenlizenz ist gültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pilot license is valid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu licencia de piloto es válida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操縦免許は有効。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조종 면허가 유효합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilot lisansın geçerli."
          }
        }
      }
    },
    "crew.licenseOk.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flieg mindestens alle %1$@ Tage selbst, um sie zu behalten. Verbleibende Tage: %2$@. Verfällt sie, bleiben deine anderen Ballone am Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fly yourself at least once every %1$@ days to keep it. Days left: %2$@. If it lapses, your other balloons stay grounded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuela tú al menos una vez cada %1$@ días para conservarla. Días restantes: %2$@. Si caduca, tus otros globos se quedan en tierra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "維持するには%1$@日に一度は自分で飛ぶこと。残り日数：%2$@。切れるとほかの気球は飛べない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지하려면 %1$@일에 한 번은 직접 비행하세요. 남은 일수: %2$@. 만료되면 다른 열기구는 지상에 묶입니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisansın düşmemesi için en az %1$@ günde bir kendin uçmalısın. Kalan gün: %2$@. Düşerse diğer balonların yerde kalır."
          }
        }
      }
    },
    "crew.licenseTitle": {
      "extractionState": "manual",
      "localizations": {
