    "map.lockedSub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird freigeschaltet, wenn du Baron von Kappadokien bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocks when you become baron of Cappadocia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desbloquea cuando seas barón de Capadocia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カッパドキアの男爵になると解放される。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카파도키아의 남작이 되면 열립니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapadokya baronu olunca açılır."
          }
        }
      }
    },
    "map.luxorSub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ufer des Nils, über dem Tal der Pharaonen. Schon sehr bald."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the banks of the Nile, above the valley of the pharaohs. Coming very soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A orillas del Nilo, sobre el valle de los faraones. Muy pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナイルのほとり、王家の谷の上空。まもなく登場。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나일강 기슭, 파라오의 계곡 위. 곧 공개됩니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nil kıyısında, firavunların vadisi üstünde. Çok yakında."
          }
        }
      }
    },
    "map.mysterySub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Abenteuer am Himmel von %@. Nicht einmal Hezarfen weiß, wo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new adventure in the skies of %@. Not even Hezarfen knows where."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nueva aventura en los cielos de %@. Ni Hezarfen sabe dónde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の空で新たな冒険。どこなのかはヘザルフェンさえ知らない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 하늘에서 펼쳐질 새로운 모험. 어디인지는 헤자르펜도 모릅니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ göğünde yeni bir macera. Nerede olduğunu Hezarfen bile bilmiyor."
          }
        }
      }
    },
