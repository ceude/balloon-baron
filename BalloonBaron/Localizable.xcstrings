    "menu.codeHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um auf einem anderen Gerät weiterzuspielen, kopiere den Code, füge ihn dort in dieses Feld ein und tippe auf Laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To continue on another device, copy the code, paste it into this box there and tap Load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para seguir en otro dispositivo, copia el código, pégalo allí en este cuadro y toca Cargar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の端末で続けるには、コードをコピーして、そちらでこの欄に貼り付け「読み込む」を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 이어 하려면 코드를 복사해 그곳의 이 칸에 붙여 넣고 불러오기를 누르세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihazda devam etmek için kodu kopyala, orada bu kutuya yapıştırıp Yükle'ye bas."
          }
        }
      }
    },
