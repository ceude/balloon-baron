      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt kaum im Gedächtnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not very memorable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se recuerda mucho."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あまり印象に残らない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별로 기억에 남지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek akılda kalmaz."
          }
        }
      }
    },
    "studio.verdict.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht schlecht, etwas gewöhnlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not bad, a bit ordinary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está mal, algo corriente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "悪くないが、少し平凡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나쁘지 않지만 조금 평범합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fena değil, biraz sıradan."
          }
        }
      }
    },
    "studio.verdict.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schön, es fällt auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice, it gets noticed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonito, llama la atención."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいね、目に留まる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요, 눈에 띕니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güzel, dikkat çeker."
          }
        }
      }
    },
    "studio.verdict.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hingucker! Alle werden Fotos machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eye-catching! Everyone will take photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Llamativo! Todos le harán fotos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目を引く！みんなが写真を撮るだろう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈길을 끕니다! 다들 사진을 찍을 거예요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göz alıcı! Herkes fotoğrafını çekecek."
          }
