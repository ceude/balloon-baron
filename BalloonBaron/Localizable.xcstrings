    "bank.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens zwei Kredite gleichzeitig. Fällt deine Kasse unter %@, pfändet die Bank einen deiner Ballons und verkauft ihn zum halben Preis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two loans at most at a time. If your cash drops below %@, the bank seizes one of your balloons and sells it at half price."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos préstamos como máximo a la vez. Si tu caja baja de %@, el banco embarga uno de tus globos y lo vende a mitad de precio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローンは同時に2件まで。資金が%@を下回ると、銀行が気球を1機差し押さえて半額で売ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대출은 동시에 최대 두 건입니다. 금고가 %@ 아래로 떨어지면 은행이 열기구 한 대를 압류해 반값에 팝니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda en fazla iki kredi. Kasa %@ altına düşerse banka bir balonuna el koyar ve yarı fiyatına satar."
          }
        }
      }
    },
