    "event.farLanding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Du bist %2$@ m vom Ziel gelandet, die Bodencrew hat dich spät gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: you landed %2$@ m from the target and the ground crew was late to find you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: aterrizaste a %2$@ m del objetivo y el equipo de tierra tardó en encontrarte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：目標から%2$@ m離れて着陸。地上クルーの到着が遅れた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 목표에서 %2$@ m 떨어진 곳에 착륙해 지상 요원이 늦게 찾았습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: hedeften %2$@ m uzağa indin, yer ekibi seni geç buldu."
          }
        }
      }
    },
    "event.founderAbsent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst seit %@ Tagen nicht im Korb. Die Passagiere fragen nach dem Gründer, die Beliebtheit bröckelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't been in a basket for %@ days. Passengers keep asking for the founder, and popularity is slipping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas %@ días sin subir a una cesta. Los pasajeros preguntan por el fundador y la popularidad cae."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@日間バスケットに乗っていない。乗客は創業者を探し、人気が落ちている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@일째 바스켓에 타지 않았습니다. 승객들이 창업자를 찾고 인기가 떨어지고 있습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gündür sepete binmedin. Yolcular kurucuyu soruyor, popülerlik eriyor."
          }
        }
      }
    },
    "event.fuel.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Lieferant erhöht den Propanpreis in den nächsten 5 Tagen um 50 %%. Zahl jetzt %@ und leg einen Vorrat zum alten Preis an, dann trifft dich die Erhöhung nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The supplier says propane goes up 50%% for the next 5 days. Pay %@ now to stock up at the old price and the rise won't touch you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor subirá el propano un 50 %% los próximos 5 días. Si pagas %@ ahora y haces acopio al precio antiguo, la subida no te afectará."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "業者によると今後5日間プロパンが50%%値上がりする。今%@払って旧価格で備蓄すれば値上げの影響はない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공급업체가 앞으로 5일간 프로판 가격을 50%% 올린다고 합니다. 지금 %@를 내고 옛 가격으로 비축하면 인상의 영향을 받지 않습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedarikçi gelecek 5 gün propana %%50 zam yapacağını söyledi. Şimdi %@ verip eski fiyattan stok yaparsan zamdan etkilenmezsin."
          }
        }
      }
    },
    "event.fuel.no": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhung zahlen (5 Tage Treibstoff ×1,5)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay the rise (5 days fuel ×1.5)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar la subida (5 días combustible ×1,5)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値上げを受け入れる（5日間燃料×1.5）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인상 감수 (5일간 연료 ×1.5)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zammı öde (5 gün yakıt ×1,5)"
          }
        }
      }
    },
    "event.fuel.title": {
      "extractionState": "manual",
      "localizations": {
